{
  "name": "crawler-plugins",
  "version": "4.4.0",
  "description": "Kabegame 爬虫插件仓库",
  "private": false,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "package": "deno run -A package-plugin.ts",
    "package:single": "deno run -A package-plugin.ts",
    "generate-index": "deno run -A generate-index.ts",
    "release": "deno task package && deno task generate-index",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "archiver": "^7.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^10.5.0",
    "husky": "^9.1.7",
    "typescript": "^5.5.0"
  }
}
