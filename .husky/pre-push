#!/usr/bin/env sh
# Non-blocking: tag 相关失败不阻断推送

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=.
cd "$ROOT" || exit 0

echo "[pre-push] ensure local release tag..."
# ensure-tag：stderr 为人读日志；若新建了 tag，stdout 仅一行 tag 名
NEW_TAG=$(bun scripts/git/ensure-tag.mjs || true)
NEW_TAG=$(printf '%s' "$NEW_TAG" | tr -d '\r' | tail -n1)

if [ -n "$NEW_TAG" ]; then
  echo "[pre-push] pushing new tag: $NEW_TAG"
  git push origin "$NEW_TAG" || true
else
  echo "[pre-push] no new tag to push (already existed or create skipped)"
fi
