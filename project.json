{
  "name": "crawler-plugins",
  "namedInputs": {
    "pluginFiles": ["{projectRoot}/plugins/**/*", "!{projectRoot}/plugins/*/dist/**/*"],
    "packageScript": [
      "{projectRoot}/package-plugin.ts",
      "{projectRoot}/project.json"
    ],
    "packageConfig": [
      "{projectRoot}/package.json",
      "{projectRoot}/bun.lock",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/bun.lock"
    ],
    "pluginPackages": [
      "{workspaceRoot}/packages/kabegame-plugin-sdk/**/*",
      "{workspaceRoot}/packages/kabegame-types/**/*"
    ],
    "cliBinary": [
      "{workspaceRoot}/target/release/kabegame-cli",
      "{workspaceRoot}/target/release/kabegame-cli.exe"
    ],
    "normalInputs": [
      "pluginFiles",
      "packageScript",
      "packageConfig",
      "pluginPackages",
      "cliBinary"
    ]
  },
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun package-plugin.ts",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["normalInputs"],
      "outputs": ["{projectRoot}/packed/**/*"]
    },
    "package-to-dev-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun package-plugin.ts --out-dir ../.kabegame/debug/data/plugins-directory",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["normalInputs"],
      "outputs": ["{workspaceRoot}/.kabegame/debug/data/plugins-directory/**/*"]
    },
    "package-to-resources": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun package-plugin.ts --out-dir ../src-tauri/kabegame/resources/plugins",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["normalInputs"],
      "outputs": ["{workspaceRoot}/src-tauri/kabegame/resources/plugins/**/*"]
    }
  }
}
