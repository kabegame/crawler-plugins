{
  "name": "crawler-plugins",
  "namedInputs": {
    "pluginFiles": ["{projectRoot}/plugins/**/*"],
    "packageScript": ["{projectRoot}/package-plugin.ts"],
    "packageConfig": [
      "{projectRoot}/package.tson",
      "{projectRoot}/pnpm-lock.yaml",
      "{projectRoot}/project.tson"
    ],
    "normalInputs": ["pluginFiles", "packageScript", "packageConfig"]
  },
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun package-plugin.ts",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["normalInputs"],
      "outputs": ["{projectRoot}/packed/**/*"]
    },
    "package-to-dev-data": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun package-plugin.ts --out-dir ../data/plugins-directory",
        "cwd": "{projectRoot}"
      },
      "cache": true,
      "inputs": ["normalInputs"],
      "outputs": ["{workspaceRoot}/data/plugins-directory/**/*"]
    }
  }
}
