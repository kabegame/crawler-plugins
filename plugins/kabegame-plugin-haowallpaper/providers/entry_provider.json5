{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.haowallpaper",
  "name": "entry_provider",
  "list": {
    "directory": {
      "provider": "directory_entry_provider",
      "meta": {
        "display": "目录",
        "plain": true,
      },
    },
    "downloads": {
      "provider": "number_range_router",
      "properties": { "json_path": "$.download_count" },
      "meta": {
        "display": "下载量",
        "plain": true,
      },
    },
    "favorites": {
      "provider": "number_range_router",
      "properties": { "json_path": "$.favorite_count" },
      "meta": {
        "display": "收藏量",
        "plain": true,
      },
    },
    "color": {
      "provider": "color_entry_provider",
      "meta": {
        "display": "色彩",
        "plain": true,
      },
    },
  },
  "note": "{\"title\":\"哲风壁纸分类\",\"content\":\"按目录、下载量、收藏量或色彩浏览哲风壁纸；站点标签与作者统一进入应用级标签画册。\"}",
}
