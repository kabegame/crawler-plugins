{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.haowallpaper",
  "name": "color_provider",
  "properties": {
    "color_name": { "type": "string", "default": "", "optional": false },
  },
  "query": {
    "where": "COALESCE((NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, '$.color') AS TEXT)), '') = ${properties.color_name}), 0)",
  },
}
