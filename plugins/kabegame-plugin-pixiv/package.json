    {
      "key": "third_party_api",
      "type": "options",
      "required": true,
      "name": "第三方 API",
      "name.en": "Third-party API",
      "name.ja": "サードパーティ API",
      "name.ko": "서드파티 API",
      "name.zhtw": "第三方 API",
      "descripts": "只从第三方 API 取作品 id，详情、标签与原图仍从 pixiv 下载（需能访问 pixiv）。",
      "descripts.en": "Only artwork ids come from the third-party API; details, tags and originals are still downloaded from pixiv (pixiv must be reachable).",
      "descripts.ja": "作品 ID のみサードパーティ API から取得し、詳細・タグ・原画は pixiv から取得します（pixiv への接続が必要）。",
      "descripts.ko": "작품 ID만 서드파티 API에서 가져오고 상세·태그·원본은 pixiv에서 받습니다(pixiv 접속 필요).",
      "descripts.zhtw": "只從第三方 API 取作品 id，詳情、標籤與原圖仍從 pixiv 下載（需能連上 pixiv）。",
      "default": "lolicon",
      "options": [
        {
          "name": "Lolicon API（随机）",
          "name.en": "Lolicon API (random)",
          "name.ja": "Lolicon API（ランダム）",
          "name.ko": "Lolicon API (랜덤)",
          "name.zhtw": "Lolicon API（隨機）",
          "variable": "lolicon"
        }
      ],
      "when": {
        "source": [
          "third_party"
        ]
      }
    },
    {
      "key": "lolicon_r18",
      "type": "options",
      "required": true,
      "name": "年龄向",
      "name.en": "Age rating",
      "name.ja": "年齢区分",
      "name.ko": "연령",
      "name.zhtw": "年齡向",
      "descripts": "按 lolicon 库内分类筛选；全年龄会再排除带 R-18 / R-18G 标签的作品。R18 与混合需在畅游登录 pixiv。",
      "descripts.en": "Filters by lolicon's own classification; General additionally drops works tagged R-18 / R-18G. R18 and Mixed need a pixiv login in Surf.",
      "descripts.ja": "lolicon の分類で絞り込み、全年齢では R-18 / R-18G タグ付き作品も除外します。R18 と混合は畅游で pixiv にログインが必要です。",
      "descripts.ko": "lolicon 분류로 필터링하며 전연령은 R-18 / R-18G 태그 작품도 제외합니다. R18과 혼합은 서핑에서 pixiv 로그인이 필요합니다.",
      "descripts.zhtw": "依 lolicon 庫內分類篩選；全年齡會再排除帶 R-18 / R-18G 標籤的作品。R18 與混合需在暢遊登入 pixiv。",
      "default": "safe",
