{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.bluedafeiyu",
  "name": "type_router",
  // 固定项列表（保持源站顺序、0 张也列出），计数按 metadata.type_ids 展开后对当前 composed 分组。
  "list": {
    "${type.type_id}": {
      "sql": "SELECT f.type_id AS type_id, f.display AS display, COALESCE(g.image_count, 0) AS image_count FROM (SELECT 1 AS ord, 'meme' AS type_id, '梗图' AS display UNION ALL SELECT 2 AS ord, 'illustration' AS type_id, '插画' AS display UNION ALL SELECT 3 AS ord, 'setting' AS type_id, '设定图' AS display UNION ALL SELECT 4 AS ord, 'comic' AS type_id, '漫画' AS display UNION ALL SELECT 5 AS ord, 'standing' AS type_id, '立绘' AS display UNION ALL SELECT 6 AS ord, 'other' AS type_id, '其他' AS display) AS f LEFT JOIN (SELECT CAST(item.value AS TEXT) AS type_id, COUNT(DISTINCT c.id) AS image_count FROM (${composed}) AS c JOIN metadata AS pm ON pm.id = c.metadata_id, json_each(CASE WHEN json_valid(pm.data) THEN COALESCE(json_extract(pm.data, '$.type_ids'), json('[]')) ELSE json('[]') END) AS item GROUP BY 1) AS g ON g.type_id = f.type_id ORDER BY f.ord",
      "data_var": "type",
      "provider": "type_provider",
      "properties": { "type_id": "${type.type_id}" },
      "meta": {
        "isLeaf": true,
        "display": "${type.display}",
        "image_count": "${type.image_count}",
      },
    },
  },
  "resolve": {
    // 只收固定 ID，避免吞掉宿主自动追加在末尾的 filter_comb 段
    "(meme|illustration|setting|comic|standing|other)": {
      "provider": "type_provider",
      "properties": { "type_id": "${capture[1]}" },
      "meta": { "isLeaf": true },
    },
  },
  "note": "{\"title\":\"作品类型\",\"content\":\"固定为源站公开的梗图、插画、设定图、漫画、立绘与其他六类。\"}",
}
