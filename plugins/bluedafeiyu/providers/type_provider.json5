{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.bluedafeiyu",
  "name": "type_provider",
  "properties": {
    "type_id": { "type": "string", "default": "", "optional": false },
  },
  "query": {
    "where": "COALESCE((EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_im.data) THEN COALESCE(json_extract(plugin_im.data, '$.type_ids'), json('[]')) ELSE json('[]') END) AS work_type WHERE CAST(work_type.value AS TEXT) = ${properties.type_id})), 0)",
  },
}
