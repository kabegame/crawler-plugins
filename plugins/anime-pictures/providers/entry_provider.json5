{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anime-pictures",
  "name": "entry_provider",
  // 标签浏览交给应用级标签（anime-pictures/<类型>），这里只提供星数与主色维度。
  "list": {
    "stars": {
      "provider": "number_range_router",
      "properties": { "json_path": "$.rating.count" },
      "meta": { "plain": true }
    },
    "color": {
      "provider": "color_router",
      "meta": { "plain": true }
    }
  },
  "note": "{\"title\":\"Anime Pictures\",\"content\":\"Filter by star count (N+ buckets; a segment also accepts <min>-<max>, <min>+ or -<max>) or by the site's dominant color name.\"}"
}
