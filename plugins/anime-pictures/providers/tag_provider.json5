{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anime-pictures",
  "name": "tag_provider",
  "properties": {
    "tag_type": { "type": "string", "default": "", "optional": false },
    "tag_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "metadata_version = 1 AND EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{\"tagGroups\":[]}' END, '$.tagGroups') AS tag_group JOIN json_each(CASE WHEN json_valid(tag_group.value) THEN COALESCE(json_extract(tag_group.value, '$.tags'), json('[]')) ELSE json('[]') END) AS tag WHERE NULLIF(TRIM(CAST(json_extract(tag_group.value, '$.name') AS TEXT)), '') = ${properties.tag_type} AND NULLIF(TRIM(CAST(json_extract(tag.value, '$.name') AS TEXT)), '') = ${properties.tag_name})"
  },
  "list": {
    "${out.name}": {
      "child_var": "out",
      "delegate": {
        "provider": "kabegame.paginate100_provider"
      },
      "provider": "${out.provider}",
      "meta": "${out.meta}"
    }
  },
  "resolve": {
    "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
      "delegate": {
        "provider": "kabegame.gallery_desc_pagination_page_comb"
      },
      "child_var": "child",
      "provider": "${child.provider}",
      "meta": "${child.meta}"
    }
  }
}
