{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anime-pictures",
  "name": "color_router",
  // 站点详情里带 color 字段的那一项是主色：links[0].text 为颜色名（如 palevioletred），按颜色名分组。
  "list": {
    "${color.color_name}": {
      "sql": "SELECT NULLIF(TRIM(CAST(json_extract(detail.value, '$.links[0].text') AS TEXT)), '') AS color_name, COUNT(DISTINCT source.id) AS image_count FROM (SELECT id, plugin_metadata FROM (${composed}) AS composed_result) AS source JOIN json_each(CASE WHEN json_valid(source.plugin_metadata) THEN source.plugin_metadata ELSE '{}' END, '$.details') AS detail WHERE json_extract(detail.value, '$.color') IS NOT NULL AND NULLIF(TRIM(CAST(json_extract(detail.value, '$.links[0].text') AS TEXT)), '') IS NOT NULL GROUP BY 1 ORDER BY image_count DESC, color_name ASC",
      "data_var": "color",
      "provider": "color_provider",
      "properties": {
        "color_name": "${color.color_name}"
      },
      "meta": {
        "isLeaf": true,
        "image_count": "${color.image_count}"
      }
    }
  },
  "resolve": {
    // 颜色名只有字母和空格（如 indian red），避免吞掉宿主自动追加的 filter_comb 段
    "([A-Za-z ]+)": {
      "provider": "color_provider",
      "properties": {
        "color_name": "${capture[1]}"
      },
      "meta": { "isLeaf": true }
    }
  }
}
