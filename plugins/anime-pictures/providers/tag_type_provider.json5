{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anime-pictures",
  "name": "tag_type_provider",
  "properties": {
    "tag_type": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "metadata_version = 1 AND EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{\"tagGroups\":[]}' END, '$.tagGroups') AS tag_group WHERE NULLIF(TRIM(CAST(json_extract(tag_group.value, '$.name') AS TEXT)), '') = ${properties.tag_type})"
  },
  "list": {
    "${tag.tag_name}": {
      "sql": "SELECT NULLIF(TRIM(CAST(json_extract(tag.value, '$.name') AS TEXT)), '') AS tag_name, COUNT(DISTINCT source.id) AS image_count FROM (SELECT id, metadata_version, plugin_metadata FROM (${composed}) AS composed_result) AS source JOIN json_each(CASE WHEN source.metadata_version = 1 AND json_valid(source.plugin_metadata) THEN source.plugin_metadata ELSE '{\"tagGroups\":[]}' END, '$.tagGroups') AS tag_group JOIN json_each(CASE WHEN json_valid(tag_group.value) THEN COALESCE(json_extract(tag_group.value, '$.tags'), json('[]')) ELSE json('[]') END) AS tag WHERE NULLIF(TRIM(CAST(json_extract(tag_group.value, '$.name') AS TEXT)), '') = ${properties.tag_type} AND NULLIF(TRIM(CAST(json_extract(tag.value, '$.name') AS TEXT)), '') IS NOT NULL GROUP BY tag_name ORDER BY image_count DESC, tag_name ASC",
      "data_var": "tag",
      "provider": "tag_provider",
      "properties": {
        "tag_type": "${properties.tag_type}",
        "tag_name": "${tag.tag_name}"
      },
      "meta": {
        "isLeaf": true,
        "image_count": "${tag.image_count}"
      }
    }
  },
  "resolve": {
    "([^/]+)": {
      "provider": "tag_provider",
      "properties": {
        "tag_type": "${properties.tag_type}",
        "tag_name": "${capture[1]}"
      },
      "meta": {
        "isLeaf": true
      }
    }
  }
}
