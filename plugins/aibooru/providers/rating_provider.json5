{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.aibooru",
  "name": "rating_provider",
  "properties": {
    "rating": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, '$.rating') AS TEXT)), '') = ${properties.rating}), 0)"
  }
}
