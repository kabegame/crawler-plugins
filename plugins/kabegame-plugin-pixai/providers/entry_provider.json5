{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.pixai",
  "name": "entry_provider",
  // 标签与作者浏览交给应用级标签（pixai/tag、pixai/artist），这里只提供互动数分段。
  "list": {
    "likes": {
      "provider": "number_range_router",
      "properties": { "json_path": "$.v2.likedCount" },
      "meta": { "plain": true }
    },
    "comments": {
      "provider": "number_range_router",
      "properties": { "json_path": "$.v2.commentCount" },
      "meta": { "plain": true }
    }
  },
  "note": "{\"title\":\"PixAI\",\"content\":\"Filter by like or comment count (N+ segments; a segment also accepts <min>-<max>, <min>+ or -<max>).\"}"
}
