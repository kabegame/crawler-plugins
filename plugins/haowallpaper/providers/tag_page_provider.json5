{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.haowallpaper",
  "name": "tag_page_provider",
  "properties": {
    "page_num": { "type": "number", "default": 1, "optional": false },
    "page_tags_json": { "type": "string", "default": "[]", "optional": true },
  },
  "query": {
    "where": "EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_metadata) THEN COALESCE(json_extract(plugin_metadata, '$.tags'), json('[]')) ELSE json('[]') END) AS image_tag WHERE NULLIF(TRIM(CAST(image_tag.value AS TEXT)), '') IN (SELECT NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.tag_name') AS TEXT)), '') FROM json_each(CASE WHEN json_valid(${properties.page_tags_json}) THEN ${properties.page_tags_json} ELSE json('[]') END) AS page_tag WHERE NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.tag_name') AS TEXT)), '') IS NOT NULL))",
  },
  "list": {
    "${tag.tag_name}": {
      "sql": "SELECT NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag_name') AS TEXT)), '') AS tag_name, CAST(json_extract(tag.value, '$.image_count') AS INTEGER) AS image_count FROM json_each(CASE WHEN json_valid(${properties.page_tags_json}) THEN ${properties.page_tags_json} ELSE json('[]') END) AS tag WHERE NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag_name') AS TEXT)), '') IS NOT NULL ORDER BY CAST(tag.key AS INTEGER)",
      "data_var": "tag",
      "provider": "tag_provider",
      "properties": {
        "tag_name": "${tag.tag_name}",
      },
      "meta": {
        "isLeaf": true,
        "display": "${tag.tag_name}",
        "image_count": "${tag.image_count}",
      },
    },
  },
  "resolve": {
    "([^/]+)": {
      "provider": "tag_provider",
      "properties": {
        "tag_name": "${capture[1]}",
      },
      "meta": {
        "isLeaf": true,
      },
    },
  },
}
