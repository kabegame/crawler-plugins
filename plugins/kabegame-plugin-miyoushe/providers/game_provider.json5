{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.miyoushe",
  "name": "game_provider",
  "properties": {
    "game_id": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((CAST(json_extract(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, '$.game_id') AS TEXT) = ${properties.game_id}), 0)"
  }
}
