{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.danbooru",
  "name": "rating_router",
  // 按 metadata.rating（General / Sensitive / Questionable / Explicit）分组；donmai.moe 只有 General。
  "list": {
    "${rating.rating}": {
      "sql": "SELECT NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{}' END, '$.rating') AS TEXT)), '') AS rating, COUNT(DISTINCT id) AS image_count FROM (${composed}) AS composed_result WHERE NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{}' END, '$.rating') AS TEXT)), '') IS NOT NULL GROUP BY 1 ORDER BY CASE rating WHEN 'General' THEN 1 WHEN 'Sensitive' THEN 2 WHEN 'Questionable' THEN 3 WHEN 'Explicit' THEN 4 ELSE 5 END, rating ASC",
      "data_var": "rating",
      "provider": "rating_provider",
      "properties": {
        "rating": "${rating.rating}"
      },
      "meta": {
        "isLeaf": true,
        "image_count": "${rating.image_count}"
      }
    }
  },
  "resolve": {
    // 只收纯字母，避免吞掉宿主自动追加在末尾的 filter_comb 段
    "([A-Za-z]+)": {
      "provider": "rating_provider",
      "properties": {
        "rating": "${capture[1]}"
      },
      "meta": { "isLeaf": true }
    }
  }
}
