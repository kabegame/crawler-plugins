<%
  // 还原 AIBooru 详情页：左侧栏（分组标签 + Information）、Original Commentary / AI Metadata 页签、下方评论区。
  // 配色取自源站亮色 :root 变量；数据来自 src/index.ts 的 buildMetadata（schema 1）。
  const m = metadata || {};
  const BASE = String(m.site || 'https://aibooru.online');
  const tags = Array.isArray(m.tags) ? m.tags : [];
  const comments = Array.isArray(m.comments) ? m.comments : [];
  const commentary = m.commentary && typeof m.commentary === 'object' ? m.commentary : null;
  const ai = m.ai_metadata && typeof m.ai_metadata === 'object' ? m.ai_metadata : null;
  const CATEGORIES = [
    ['artist', 'Artist'], ['model', 'Model'], ['copyright', 'Copyrights'],
    ['character', 'Character'], ['general', 'General'], ['meta', 'Meta'],
  ];
  const grouped = {};
  tags.forEach(function (t) {
    if (!t || !t.name) return;
    const ty = CATEGORIES.some(function (c) { return c[0] === t.type; }) ? t.type : 'general';
    (grouped[ty] || (grouped[ty] = [])).push(t);
  });
  function enc(s) { return encodeURIComponent(String(s == null ? '' : s)); }
  function fmtCount(n) {
    n = Number(n);
    if (!isFinite(n) || n < 0) return '';
    // 与源站一致向下取整：10.6k 显示 10k，1.06k 显示 1.0k
    if (n >= 1e6) return (Math.floor(n / 1e5) / 10).toFixed(1) + 'M';
    if (n >= 1e4) return Math.floor(n / 1e3) + 'k';
    if (n >= 1e3) return (Math.floor(n / 1e2) / 10).toFixed(1) + 'k';
    return String(n);
  }
  function fmtSize(n) {
    n = Number(n);
    if (!(n > 0)) return '';
    if (n >= 1048576) return (n / 1048576).toFixed(2) + ' MB';
    if (n >= 1024) return Math.round(n / 1024) + ' KB';
    return n + ' B';
  }
  function fmtTitle(iso) {
    const d = new Date(iso);
    return (!iso || isNaN(d)) ? '' : d.toISOString().replace('T', ' ').replace(/\.\d+Z$/, ' UTC');
  }
  // 站点用 Rails 的 time_ago_in_words（"over 2 years ago"），这里按同样的分档输出
  function fmtAgo(iso) {
    const d = new Date(iso);
    if (!iso || isNaN(d)) return '';
    const min = Math.round((Date.now() - d.getTime()) / 60000);
    if (min < 1) return 'less than a minute ago';
    if (min < 45) return min + (min === 1 ? ' minute' : ' minutes') + ' ago';
    if (min < 90) return 'about 1 hour ago';
    if (min < 1440) return 'about ' + Math.round(min / 60) + ' hours ago';
    if (min < 2520) return '1 day ago';
    if (min < 43200) return Math.round(min / 1440) + ' days ago';
    if (min < 86400) return 'about 1 month ago';
    if (min < 525600) return Math.round(min / 43200) + ' months ago';
    const years = Math.floor(min / 525600);
    const rest = min % 525600;
    const y = years + (years === 1 ? ' year' : ' years');
    if (rest < 131400) return 'about ' + y + ' ago';
    if (rest < 394200) return 'over ' + y + ' ago';
    return 'almost ' + (years + 1) + ' years ago';
  }
  function userClass(u) {
    const lv = String((u && u.level) || '').toLowerCase();
    if (lv === 'admin' || lv === 'owner') return 'ab-user-admin';
    if (lv === 'moderator') return 'ab-user-moderator';
    if (lv === 'builder' || lv === 'contributor' || lv === 'approver') return 'ab-user-builder';
    if (lv === 'platinum') return 'ab-user-platinum';
    if (lv === 'gold') return 'ab-user-gold';
    return 'ab-user-member';
  }
  function userName(u) { return String((u && u.name) || '').replace(/_/g, ' '); }
  const dims = (m.width && m.height) ? (m.width + 'x' + m.height) : '';
  const source = String(m.source || '');
  const sourceIsUrl = /^https?:\/\//i.test(source);
  const sourceText = source.replace(/^https?:\/\/(www\.)?/i, '');

  // AI Metadata 表：固定五项在前，其余 parameters 去掉与之重复的键后按字母序（与源站一致）
  const aiRows = [];
  if (ai) {
    const fixed = [
      ['Prompt', ai.prompt], ['Negative prompt', ai.negative_prompt], ['Sampler', ai.sampler],
      ['Seed', ai.seed], ['Steps', ai.steps], ['Cfg Scale', ai.cfg_scale], ['Model Hash', ai.model_hash],
    ];
    fixed.forEach(function (r) { if (r[1] != null && String(r[1]) !== '') aiRows.push(r); });
    const seen = {};
    fixed.forEach(function (r) { seen[r[0].toLowerCase()] = true; });
    const params = ai.parameters && typeof ai.parameters === 'object' ? ai.parameters : {};
    Object.keys(params).sort(function (a, b) { return a.localeCompare(b); }).forEach(function (k) {
      const v = params[k];
      if (seen[String(k).toLowerCase()] || v == null || String(v) === '') return;
      aiRows.push([k, typeof v === 'object' ? JSON.stringify(v) : v]);
    });
  }
  const hasCommentary = !!(commentary && (commentary.original_title || commentary.original_description ||
    commentary.translated_title || commentary.translated_description));
  const hasAi = aiRows.length > 0;
%>
<style>
.ab{font-family:Verdana,Helvetica,sans-serif;font-size:13px;line-height:1.35;color:#000;background:#fff;padding:10px 12px;}
.ab a{color:#0075f8;text-decoration:none;}
.ab a:hover{text-decoration:underline;}
.ab h3{margin:12px 0 2px;font-size:13px;font-weight:bold;color:#1e1e2c;}
.ab h2{margin:16px 0 6px;font-size:15px;font-weight:bold;color:#1e1e2c;}
.ab ul{list-style:none;margin:0;padding:0;}
.ab-tags li{margin:1px 0;word-break:break-word;}
.ab-tags .count{color:#9192a7;margin-left:4px;}
.ab-tags .wiki{margin-right:5px;}
.ab .tag-artist a{color:#c00004;}
.ab .tag-model a{color:#777892;}
.ab .tag-copyright a{color:#a800aa;}
.ab .tag-character a{color:#00ab2c;}
.ab .tag-general a{color:#0075f8;}
.ab .tag-meta a{color:#fd9200;}
.ab-info li{margin:1px 0;word-break:break-word;}
.ab-src{word-break:break-all;}
.ab .ab-user-admin{color:#ed2426;}
.ab .ab-user-moderator{color:#00ab2c;}
.ab .ab-user-builder{color:#a800aa;}
.ab .ab-user-platinum{color:#777892;}
.ab .ab-user-gold{color:#fd9200;}
.ab .ab-user-member{color:#0075f8;}
.ab-box{margin-top:14px;padding:6px 8px;background:#f6f6f8;border:1px solid #e8e8ec;}
.ab-box > input{display:none;}
.ab-tablist{display:flex;gap:1rem;border-bottom:1px solid #d1d1da;margin-bottom:8px;}
.ab-tablist label{cursor:pointer;padding:4px 4px 6px;color:#9192a7;}
.ab-panel{display:none;}
#ab-t-c:checked ~ .ab-tablist label[for="ab-t-c"],
#ab-t-a:checked ~ .ab-tablist label[for="ab-t-a"]{color:#0075f8;border-bottom:2px solid #0075f8;}
#ab-t-c:checked ~ .ab-panel-c,#ab-t-a:checked ~ .ab-panel-a{display:block;}
.ab-commentary-title{font-weight:bold;margin:0 0 4px;}
.ab-prose{white-space:pre-wrap;word-break:break-word;margin:0;}
.ab-translated{margin-top:8px;padding-top:6px;border-top:1px dashed #d1d1da;}
.ab-ai{width:100%;border-collapse:collapse;}
.ab-ai th,.ab-ai td{padding:4px 6px;text-align:left;vertical-align:top;overflow-wrap:anywhere;}
.ab-ai th{width:34%;font-weight:bold;}
.ab-ai tr{border-bottom:1px solid #d1d1da;}
.ab-ai tr:nth-child(even){background:#fff;}
.ab-comment{display:flex;flex-direction:column;gap:4px;padding:8px 4px;border-bottom:1px solid #e8e8ec;}
.ab-comment.sticky{background:#f4f6ff;}
.ab-comment .who{display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;}
.ab-comment time{font-style:italic;font-size:11px;color:#9192a7;}
.ab-comment .score{font-size:12px;color:#000;}
.ab-comment.deleted{color:#9192a7;}
.ab-hint{margin-top:12px;font-size:11px;color:#9192a7;}
</style>
<div class="ab">
  <% CATEGORIES.forEach(function (c) { const list = grouped[c[0]]; if (!list || !list.length) return; %>
  <h3><%= c[1] %></h3>
  <ul class="ab-tags">
    <% list.forEach(function (t) { %>
    <li class="tag-<%= c[0] %>">
      <a class="wiki" href="<%= BASE %>/wiki_pages/<%= enc(t.name) %>" target="_blank" rel="noopener noreferrer">?</a><a href="<%= BASE %>/posts?tags=<%= enc(t.name) %>" target="_blank" rel="noopener noreferrer"><%= t.display || String(t.name).replace(/_/g, ' ') %></a><% if (t.count != null && fmtCount(t.count)) { %><span class="count" title="<%= t.count %>"><%= fmtCount(t.count) %></span><% } %>
    </li>
    <% }); %>
  </ul>
  <% }); %>

  <h3>Information</h3>
  <ul class="ab-info">
    <% if (m.post_id != null) { %><li>ID: <a href="<%= m.post_url || (BASE + '/posts/' + m.post_id) %>" target="_blank" rel="noopener noreferrer"><%= m.post_id %></a></li><% } %>
    <% if (m.uploader) { %><li>Uploader: <a class="<%= userClass(m.uploader) %>" href="<%= BASE %>/users/<%= enc(m.uploader.id) %>" target="_blank" rel="noopener noreferrer"><%= userName(m.uploader) %></a></li><% } %>
    <% if (m.created_at) { %><li>Date: <time title="<%= fmtTitle(m.created_at) %>"><%= fmtAgo(m.created_at) %></time></li><% } %>
    <% if (m.approver) { %><li>Approver: <a class="<%= userClass(m.approver) %>" href="<%= BASE %>/users/<%= enc(m.approver.id) %>" target="_blank" rel="noopener noreferrer"><%= userName(m.approver) %></a></li><% } %>
    <% if (m.file_size || m.file_ext || dims) { %>
    <li>Size: <% if (m.original_url) { %><a href="<%= m.original_url %>" target="_blank" rel="noopener noreferrer"><%= fmtSize(m.file_size) %><% if (m.file_ext) { %> .<%= m.file_ext %><% } %></a><% } else { %><%= fmtSize(m.file_size) %><% if (m.file_ext) { %> .<%= m.file_ext %><% } %><% } %><% if (dims) { %> (<%= dims %>)<% } %><% if (m.duration) { %>, <%= Math.round(Number(m.duration)) %>s<% } %></li>
    <% } %>
    <% if (source) { %><li>Source: <% if (sourceIsUrl) { %><a class="ab-src" href="<%= source %>" target="_blank" rel="noopener noreferrer"><%= sourceText %></a><% } else { %><span class="ab-src"><%= source %></span><% } %></li><% } %>
    <% if (m.rating) { %><li>Rating: <%= m.rating %></li><% } %>
    <% if (m.views != null) { %><li>Views: <%= m.views %></li><% } %>
    <% if (m.score != null) { %><li>Score: <span title="+<%= m.up_score == null ? 0 : m.up_score %> / -<%= Math.abs(Number(m.down_score) || 0) %>"><%= m.score %></span></li><% } %>
    <% if (m.fav_count != null) { %><li>Favorites: <%= m.fav_count %></li><% } %>
    <% if (m.status) { %><li>Status: <%= m.status %></li><% } %>
  </ul>

  <% if (hasCommentary || hasAi) { %>
  <div class="ab-box">
    <% if (hasCommentary) { %><input type="radio" name="ab-tab" id="ab-t-c" checked><% } %>
    <% if (hasAi) { %><input type="radio" name="ab-tab" id="ab-t-a"<% if (!hasCommentary) { %> checked<% } %>><% } %>
    <div class="ab-tablist">
      <% if (hasCommentary) { %><label for="ab-t-c">Original Commentary</label><% } %>
      <% if (hasAi) { %><label for="ab-t-a">AI Metadata</label><% } %>
    </div>
    <% if (hasCommentary) { %>
    <div class="ab-panel ab-panel-c">
      <% if (commentary.original_title) { %><p class="ab-commentary-title"><%= commentary.original_title %></p><% } %>
      <% if (commentary.original_description) { %><p class="ab-prose"><%= commentary.original_description %></p><% } %>
      <% if (commentary.translated_title || commentary.translated_description) { %>
      <div class="ab-translated">
        <% if (commentary.translated_title) { %><p class="ab-commentary-title"><%= commentary.translated_title %></p><% } %>
        <% if (commentary.translated_description) { %><p class="ab-prose"><%= commentary.translated_description %></p><% } %>
      </div>
      <% } %>
    </div>
    <% } %>
    <% if (hasAi) { %>
    <div class="ab-panel ab-panel-a">
      <table class="ab-ai"><tbody>
        <% aiRows.forEach(function (r) { %>
        <tr><th><%= r[0] %></th><td><%= r[1] %></td></tr>
        <% }); %>
      </tbody></table>
    </div>
    <% } %>
  </div>
  <% } %>

  <% if (comments.length) { %>
  <h2>Comments</h2>
  <% comments.forEach(function (c) { %>
  <div class="ab-comment<%= c.is_deleted ? ' deleted' : '' %><%= c.is_sticky ? ' sticky' : '' %>">
    <div class="who">
      <% if (c.is_deleted || !c.creator) { %>[deleted]<% } else { %><a class="<%= userClass(c.creator) %>" href="<%= BASE %>/users/<%= enc(c.creator.id) %>" target="_blank" rel="noopener noreferrer"><%= userName(c.creator) %></a><% } %>
      <time title="<%= fmtTitle(c.created_at) %>"><%= fmtAgo(c.created_at) %></time>
    </div>
    <% if (c.is_deleted) { %>
    <p class="ab-prose">[deleted]</p>
    <% } else { %>
    <p class="ab-prose"><%= c.body %></p>
    <% if (c.score != null) { %><span class="score">▲ <%= c.score %></span><% } %>
    <% } %>
  </div>
  <% }); %>
  <% } %>

  <p class="ab-hint">Snapshot from download time; may differ from the live site.</p>
</div>
