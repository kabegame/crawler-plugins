{
  "name": "kabegame-plugin-theanimegallery",
  "version": "0.1.0",
  "private": true,
  "name.zh": "The Anime Gallery 壁纸",
  "name.en": "The Anime Gallery wallpapers",
  "name.ja": "The Anime Gallery 壁紙",
  "name.ko": "The Anime Gallery 배경화면",
  "name.zhtw": "The Anime Gallery 桌布",
  "description": "theanimegallery.com 动漫壁纸爬虫",
  "description.zh": "theanimegallery.com 动漫壁纸爬虫",
  "description.en": "Crawler for theanimegallery.com anime wallpapers",
  "description.ja": "theanimegallery.com アニメ壁紙クローラー",
  "description.ko": "theanimegallery.com 애니메이션 배경화면 크롤러",
  "description.zhtw": "theanimegallery.com 動漫桌布爬蟲",
  "author": "Kabegame",
  "kbPackageVersion": 3,
  "engines": { "kabegame": ">=4.5.2" },
  "main": "dist/main.js",
  "kbBackend": "v8",
  "scripts": { "build": "rspack build" },
  "kbBaseUrl": "https://theanimegallery.com",
  "kbIcon": "icon.png",
  "kbDoc": { "default": "docs/doc.md" },
  "kbDescriptionTemplate": "templates/description.ejs",
  "kbLabels": [{ "id": "content.res.desktop" }, { "id": "content.res.mobile" }],
  "kbConfig": [
    {
      "key": "mode",
      "type": "options",
      "required": true,
      "name": "Mode",
      "name.zh": "模式",
      "name.ja": "モード",
      "name.ko": "모드",
      "name.zhtw": "模式",
      "descripts": "Featured on home page, browse by category, or search by keyword.",
      "descripts.zh": "首页精选、按分类浏览或按关键词搜索。",
      "descripts.ja": "ホームの注目、カテゴリ別、またはキーワード検索で取得します。",
      "descripts.ko": "홈 추천, 카테고리별 또는 키워드 검색으로 수집합니다.",
      "descripts.zhtw": "首頁精選、依分類瀏覽或依關鍵字搜尋。",
      "default": "home",
      "options": [
        {
          "name": "Featured",
          "name.zh": "首页精选",
          "name.ja": "ホームの注目",
          "name.ko": "홈 추천",
          "name.zhtw": "首頁精選",
          "variable": "home"
        },
        {
          "name": "Category",
          "name.zh": "分类",
          "name.ja": "カテゴリ",
          "name.ko": "카테고리",
          "name.zhtw": "分類",
          "variable": "category"
        },
        {
          "name": "Search",
          "name.zh": "搜索",
          "name.ja": "検索",
          "name.ko": "검색",
          "name.zhtw": "搜尋",
          "variable": "search"
        }
      ]
    },
    {
      "key": "category",
      "type": "options",
      "required": true,
      "name": "Category",
      "name.zh": "分类",
      "name.ja": "カテゴリ",
      "name.ko": "카테고리",
      "name.zhtw": "分類",
      "descripts": "Site category; one category returns at most 80 wallpapers.",
      "descripts.zh": "站点分类，一个分类最多返回 80 张壁纸。",
      "descripts.ja": "サイトのカテゴリ。1 カテゴリで最大 80 枚返ります。",
      "descripts.ko": "사이트 카테고리. 한 카테고리는 최대 80장을 반환합니다.",
      "descripts.zhtw": "站點分類，一個分類最多回傳 80 張桌布。",
      "default": "anime",
      "when": { "mode": ["category"] },
      "options": [
        { "name": "Academia", "variable": "academia" },
        { "name": "Aesthetic", "variable": "aesthetic" },
        { "name": "Android", "variable": "android" },
        { "name": "Anime", "variable": "anime" },
        { "name": "Background", "variable": "background" },
        { "name": "Backgrounds", "variable": "backgrounds" },
        { "name": "Ball", "variable": "ball" },
        { "name": "Berserk", "variable": "berserk" },
        { "name": "Black", "variable": "black" },
        { "name": "Bleach", "variable": "bleach" },
        { "name": "Cartoon", "variable": "cartoon" },
        { "name": "Chainsaw", "variable": "chainsaw" },
        { "name": "Cool", "variable": "cool" },
        { "name": "Couple", "variable": "couple" },
        { "name": "Cute", "variable": "cute" },
        { "name": "Demon", "variable": "demon" },
        { "name": "Desktop", "variable": "desktop" },
        { "name": "Evangelion", "variable": "evangelion" },
        { "name": "Free", "variable": "free" },
        { "name": "Gear", "variable": "gear" },
        { "name": "Goku", "variable": "goku" },
        { "name": "Gundam", "variable": "gundam" },
        { "name": "Haikyuu", "variable": "haikyuu" },
        { "name": "Hunter", "variable": "hunter" },
        { "name": "Ipad", "variable": "ipad" },
        { "name": "Iphone", "variable": "iphone" },
        { "name": "Itachi", "variable": "itachi" },
        { "name": "Kaisen", "variable": "kaisen" },
        { "name": "Kakashi", "variable": "kakashi" },
        { "name": "Laptop", "variable": "laptop" },
        { "name": "Luffy", "variable": "luffy" },
        { "name": "Manga", "variable": "manga" },
        { "name": "Moving", "variable": "moving" },
        { "name": "Naruto", "variable": "naruto" },
        { "name": "Phone", "variable": "phone" },
        { "name": "Photo", "variable": "photo" },
        { "name": "Piece", "variable": "piece" },
        { "name": "Sailor", "variable": "sailor" },
        { "name": "Sasuke", "variable": "sasuke" },
        { "name": "Slayer", "variable": "slayer" },
        { "name": "Tokyo", "variable": "tokyo" },
        { "name": "Wall", "variable": "wall" },
        { "name": "Wallpaper", "variable": "wallpaper" },
        { "name": "Wallpapers", "variable": "wallpapers" },
        { "name": "Windows", "variable": "windows" },
        { "name": "Zoro", "variable": "zoro" }
      ]
    },
    {
      "key": "keyword",
      "type": "string",
      "required": true,
      "name": "Keyword",
      "name.zh": "关键词",
      "name.ja": "キーワード",
      "name.ko": "키워드",
      "name.zhtw": "關鍵字",
      "descripts": "Search keyword, e.g. miku or dragon ball. One search returns at most 80 wallpapers.",
      "descripts.zh": "搜索关键词，例如 miku 或 dragon ball。一次搜索最多返回 80 张壁纸。",
      "descripts.ja": "検索キーワード。例：miku、dragon ball。1 回の検索で最大 80 枚返ります。",
      "descripts.ko": "검색 키워드. 예: miku, dragon ball. 한 번의 검색은 최대 80장을 반환합니다.",
      "descripts.zhtw": "搜尋關鍵字，例如 miku 或 dragon ball。一次搜尋最多回傳 80 張桌布。",
      "when": { "mode": ["search"] }
    }
  ],
  "devDependencies": {
    "@kabegame/plugin-sdk": "file:../../../packages/kabegame-plugin-sdk",
    "@kabegame/types": "file:../../../packages/kabegame-types",
    "@rspack/cli": "^1",
    "@rspack/core": "^1",
    "typescript": "^5.5.0"
  }
}
