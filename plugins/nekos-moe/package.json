{
  "name": "nekos-moe",
  "version": "0.1.1",
  "private": true,
  "name.zh": "nekos.moe 猫娘图库",
  "name.en": "nekos.moe catgirls",
  "name.ja": "nekos.moe 猫耳画像",
  "name.ko": "nekos.moe 고양이 소녀",
  "name.zhtw": "nekos.moe 貓娘圖庫",
  "description": "nekos.moe 开源猫娘图库收集源插件",
  "description.zh": "nekos.moe 开源猫娘图库收集源插件",
  "description.en": "Crawler plugin for nekos.moe, an open-source catgirl image board",
  "description.ja": "オープンソースの猫耳画像サイト nekos.moe の収集プラグイン",
  "description.ko": "오픈소스 고양이 소녀 이미지 보드 nekos.moe 수집 플러그인",
  "description.zhtw": "nekos.moe 開源貓娘圖庫收集源外掛",
  "author": "Kabegame",
  "kbPackageVersion": 3,
  "engines": {
    "kabegame": ">=4.3.0"
  },
  "main": "dist/main.js",
  "kbBackend": "v8",
  "scripts": {
    "build": "rspack build"
  },
  "kbBaseUrl": "https://nekos.moe",
  "kbLabels": [
    {
      "id": "content.nsfw"
    }
  ],
  "kbConfig": [
    {
      "key": "sort",
      "type": "options",
      "required": true,
      "name": "Sort order",
      "name.zh": "排序",
      "name.ja": "並び順",
      "name.ko": "정렬",
      "name.zhtw": "排序",
      "descripts": "Same as the sort options on the site's search page.",
      "descripts.zh": "与站点搜索页的排序一致。",
      "descripts.ja": "サイトの検索ページの並び順と同じです。",
      "descripts.ko": "사이트 검색 페이지의 정렬과 같습니다.",
      "descripts.zhtw": "與站點搜尋頁的排序一致。",
      "default": "newest",
      "options": [
        {
          "name": "Newest",
          "name.zh": "最新",
          "name.ja": "新しい順",
          "name.ko": "최신순",
          "name.zhtw": "最新",
          "variable": "newest"
        },
        {
          "name": "Most liked",
          "name.zh": "最多点赞",
          "name.ja": "いいね順",
          "name.ko": "좋아요순",
          "name.zhtw": "最多按讚",
          "variable": "likes"
        },
        {
          "name": "Oldest",
          "name.zh": "最早",
          "name.ja": "古い順",
          "name.ko": "오래된순",
          "name.zhtw": "最早",
          "variable": "oldest"
        }
      ]
    },
    {
      "key": "nsfw",
      "type": "options",
      "required": true,
      "name": "NSFW",
      "name.zh": "NSFW 内容",
      "name.ja": "NSFW コンテンツ",
      "name.ko": "NSFW 콘텐츠",
      "name.zhtw": "NSFW 內容",
      "descripts": "Whether to include images marked NSFW by the site.",
      "descripts.zh": "是否包含站点标记为 NSFW 的图片。",
      "descripts.ja": "サイトで NSFW と指定された画像を含めるかどうか。",
      "descripts.ko": "사이트에서 NSFW로 표시된 이미지를 포함할지 여부입니다.",
      "descripts.zhtw": "是否包含站點標記為 NSFW 的圖片。",
      "default": "sfw",
      "options": [
        {
          "name": "SFW only",
          "name.zh": "仅全年龄",
          "name.ja": "全年齢のみ",
          "name.ko": "전체 이용가만",
          "name.zhtw": "僅全年齡",
          "variable": "sfw"
        },
        {
          "name": "NSFW only",
          "name.zh": "仅 NSFW",
          "name.ja": "NSFW のみ",
          "name.ko": "NSFW만",
          "name.zhtw": "僅 NSFW",
          "variable": "nsfw"
        },
        {
          "name": "All",
          "name.zh": "全部",
          "name.ja": "すべて",
          "name.ko": "전체",
          "name.zhtw": "全部",
          "variable": "all"
        }
      ]
    },
    {
      "key": "page_size",
      "type": "int",
      "name": "Page size",
      "name.zh": "每页数量",
      "name.ja": "1ページの件数",
      "name.ko": "페이지당 개수",
      "name.zhtw": "每頁數量",
      "descripts": "Images per page; the site allows at most 50.",
      "descripts.zh": "每页的图片数，站点最多 50。",
      "descripts.ja": "1ページあたりの画像数。サイトの上限は 50 です。",
      "descripts.ko": "페이지당 이미지 수이며 사이트 최대값은 50입니다.",
      "descripts.zhtw": "每頁的圖片數，站點最多 50。",
      "default": 50,
      "min": 1,
      "max": 50
    },
    {
      "key": "start_page",
      "type": "int",
      "name": "Start page",
      "name.zh": "起始页",
      "name.ja": "開始ページ",
      "name.ko": "시작 페이지",
      "name.zhtw": "起始頁",
      "default": 1,
      "min": 1,
      "width": 2
    },
    {
      "key": "end_page",
      "type": "int",
      "name": "End page",
      "name.zh": "结束页",
      "name.ja": "終了ページ",
      "name.ko": "끝 페이지",
      "name.zhtw": "結束頁",
      "descripts": "Stops early after the last page.",
      "descripts.zh": "超过最后一页时提前结束。",
      "descripts.ja": "最終ページを過ぎると早めに終了します。",
      "descripts.ko": "마지막 페이지를 넘으면 일찍 종료합니다.",
      "descripts.zhtw": "超過最後一頁時提前結束。",
      "default": 1,
      "min": 1,
      "width": 2
    }
  ],
  "kbIcon": "icon.png",
  "kbDoc": {
    "default": "README.md"
  },
  "kbChangelog": {
    "default": "CHANGELOG.md"
  },
  "kbDescriptionTemplate": "templates/description.ejs",
  "devDependencies": {
    "@kabegame/plugin-sdk": "file:../../../packages/kabegame-plugin-sdk",
    "@kabegame/types": "file:../../../packages/kabegame-types",
    "@rspack/cli": "^1",
    "@rspack/core": "^1",
    "typescript": "^5.5.0"
  }
}
