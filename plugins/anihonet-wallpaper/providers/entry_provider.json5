{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anihonet-wallpaper",
  "name": "entry_provider",
  "list": {
    "quality": {
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "quality"
      }
    },
    "work": {
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "work"
      }
    },
    "character": {
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "character"
      }
    }
  },
  "resolve": {
    "([^/]+)": {
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "${capture[1]}"
      }
    }
  },
  "note": "{\"title\":\"anihonet tags\",\"content\":\"Group anihonet images by quality and character tags from image metadata.\"}"
}
