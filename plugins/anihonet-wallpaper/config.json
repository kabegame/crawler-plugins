{
  "baseUrl": "https://anihonetwallpaper.com",
  "selector": null,
  "var": [
    {
      "key": "crawl_mode",
      "type": "options",
      "name": "爬取模式",
      "name.en": "Crawl mode",
      "name.ja": "取得モード",
      "name.ko": "수집 모드",
      "name.zhtw": "爬取模式",
      "descripts": "排行榜：按周期排行页抓取。作品索引：从作品タイトル一覧按假名行勾选后抓取",
      "descripts.en": "Ranking pages, or anime/game title index by row (あ行〜わ行)",
      "descripts.ja": "ランキングページ、または作品タイトル一覧（あ行〜わ行）",
      "descripts.ko": "랭킹 페이지 또는 작품 제목 목록(あ〜わ 행)",
      "descripts.zhtw": "排行榜：依週期排行頁。作品索引：依假名行勾選",
      "default": "ranking",
      "options": [
        {
          "name": "排行榜",
          "name.en": "Ranking",
          "name.ja": "ランキング",
          "name.ko": "랭킹",
          "name.zhtw": "排行榜",
          "variable": "ranking"
        },
        {
          "name": "作品索引（アニメ・ゲーム一覧）",
          "name.en": "Title index (anime/game)",
          "name.ja": "作品タイトル一覧",
          "name.ko": "작품 제목 목록",
          "name.zhtw": "作品索引（動漫・遊戲一覽）",
          "variable": "anime_game"
        }
      ]
    },
    {
      "key": "anime_game_rows",
      "type": "checkbox",
      "name": "假名行（仅作品索引模式）",
      "name.en": "Kana rows (index mode only)",
      "name.ja": "かな行（一覧モードのみ）",
      "name.ko": "가나 행(목록 모드만)",
      "name.zhtw": "假名行（僅作品索引）",
      "descripts": "在作品一覧页按 h3 id 分段：あ・か・さ・た・な / は・ま・や・ら・わ",
      "descripts.en": "Sections by row: a, ka, sa… / ha, ma, ya, ra, wa",
      "descripts.ja": "あ行〜わ行ブロック（id=a,ka,…,wa）",
      "descripts.ko": "あ〜わ 블록",
      "descripts.zhtw": "對應頁面 h3 id：a, ka, …, wa",
      "default": ["a", "ka", "sa", "ta", "na", "ha", "ma", "ya", "ra", "wa"],
      "options": [
        { "name": "-あ行-", "name.en": "A row", "variable": "a" },
        { "name": "-か行-", "name.en": "Ka row", "variable": "ka" },
        { "name": "-さ行-", "name.en": "Sa row", "variable": "sa" },
        { "name": "-た行-", "name.en": "Ta row", "variable": "ta" },
        { "name": "-な行-", "name.en": "Na row", "variable": "na" },
        { "name": "-は行-", "name.en": "Ha row", "variable": "ha" },
        { "name": "-ま行-", "name.en": "Ma row", "variable": "ma" },
        { "name": "-や行-", "name.en": "Ya row", "variable": "ya" },
        { "name": "-ら行-", "name.en": "Ra row", "variable": "ra" },
        { "name": "-わ行-", "name.en": "Wa row", "variable": "wa" }
      ],
      "when": { "crawl_mode": ["anime_game"] }
    },
    {
      "key": "start_page",
      "type": "int",
      "name": "起始页面",
      "name.en": "Start page",
      "name.ja": "開始ページ",
      "name.ko": "시작 페이지",
      "name.zhtw": "起始頁面",
      "descripts": "要拉取的起始页面",
      "descripts.en": "Start page to crawl from",
      "descripts.ja": "取得開始ページ",
      "descripts.ko": "가져올 시작 페이지",
      "descripts.zhtw": "要拉取的起始頁面",
      "default": 1,
      "options": null,
      "min": 1,
      "max": 5,
      "when": { "crawl_mode": ["ranking"] }
    },
    {
      "key": "end_page",
      "type": "int",
      "name": "结束页数",
      "name.en": "End page",
      "name.ja": "終了ページ",
      "name.ko": "끝 페이지",
      "name.zhtw": "結束頁數",
      "descripts": "要拉取的结束页面",
      "descripts.en": "End page to crawl to",
      "descripts.ja": "取得終了ページ",
      "descripts.ko": "가져올 끝 페이지",
      "descripts.zhtw": "要拉取的結束頁面",
      "default": 5,
      "options": null,
      "min": 1,
      "max": 5,
      "when": { "crawl_mode": ["ranking"] }
    },
    {
      "key": "wallpaper_type",
      "type": "options",
      "name": "壁纸类型",
      "name.en": "Wallpaper type",
      "name.ja": "壁紙タイプ",
      "name.ko": "벽지 유형",
      "name.zhtw": "壁紙類型",
      "descripts": "选择要爬取的壁纸类型：桌面壁纸（imgpc）或手机壁纸（sp）",
      "descripts.en": "Desktop (imgpc) or mobile (sp) wallpapers",
      "descripts.ja": "デスクトップ（imgpc）またはモバイル（sp）壁紙",
      "descripts.ko": "데스크톱(imgpc) 또는 모바일(sp) 벽지",
      "descripts.zhtw": "選擇要爬取的壁紙類型：桌面壁紙（imgpc）或手機壁紙（sp）",
      "default": "imgpc",
      "options": [
        {
          "name": "桌面壁纸",
          "name.en": "Desktop",
          "name.ja": "デスクトップ",
          "name.ko": "데스크톱",
          "name.zhtw": "桌面壁紙",
          "variable": "imgpc"
        },
        {
          "name": "手机壁纸",
          "name.en": "Mobile",
          "name.ja": "モバイル",
          "name.ko": "모바일",
          "name.zhtw": "手機壁紙",
          "variable": "sp"
        }
      ]
    },
    {
      "key": "ranking_period",
      "type": "options",
      "name": "排行榜周期",
      "name.en": "Ranking period",
      "name.ja": "ランキング期間",
      "name.ko": "랭킹 기간",
      "name.zhtw": "排行榜週期",
      "descripts": "选择要爬取的排行榜周期：日榜、周榜、月榜或年榜",
      "descripts.en": "Daily, weekly, monthly or annual ranking",
      "descripts.ja": "日間・週間・月間・年間ランキング",
      "descripts.ko": "일간·주간·월간·연간 랭킹",
      "descripts.zhtw": "選擇要爬取的排行榜週期：日榜、週榜、月榜或年榜",
      "default": "daily",
      "options": [
        {
          "name": "日榜",
          "name.en": "Daily",
          "name.ja": "日間",
          "name.ko": "일간",
          "name.zhtw": "日榜",
          "variable": "daily"
        },
        {
          "name": "周榜",
          "name.en": "Weekly",
          "name.ja": "週間",
          "name.ko": "주간",
          "name.zhtw": "週榜",
          "variable": "weekly"
        },
        {
          "name": "月榜",
          "name.en": "Monthly",
          "name.ja": "月間",
          "name.ko": "월간",
          "name.zhtw": "月榜",
          "variable": "monthly"
        },
        {
          "name": "年榜",
          "name.en": "Annual",
          "name.ja": "年間",
          "name.ko": "연간",
          "name.zhtw": "年榜",
          "variable": "annual"
        }
      ],
      "min": null,
      "max": null,
      "when": { "crawl_mode": ["ranking"] }
    }
  ]
}
