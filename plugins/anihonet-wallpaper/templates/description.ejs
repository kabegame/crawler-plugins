<% const m = metadata || {}; %>
<%
  function esc(s) {
    if (s == null) return '';
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function tagList(v) {
    if (!Array.isArray(v)) return [];
    return v.filter(function (t) {
      if (!t) return false;
      const label = t.name != null ? String(t.name) : '';
      const href = t.href != null ? String(t.href) : '';
      return !!label || !!href;
    });
  }
  const rawDate = m.date != null && String(m.date).trim() !== '' ? String(m.date).trim() : '';
  let displayDate = rawDate;
  if (rawDate && rawDate.indexOf('T') >= 0) {
    displayDate = rawDate.split('T')[0];
  }
  const sourceId = m.post_id != null ? String(m.post_id).trim() : '';
  const sourceUrl = sourceId ? `https://anihonetwallpaper.com/post/${sourceId}` : '';
  const sourceText = sourceId ? `#${sourceId}` : '';

  // Version dispatch: the crawler / migrations stamp `schema` into metadata.
  //   schema >= 2 -> 画像=quality / 壁紙=work / 残り=character
  //   schema == 1 -> quality (画像+壁紙 合算) / character
  //   schema 0 / 旧データ -> フラットな tags をそのまま表示
  const schema = Number(m.schema || 0);
  let groups;
  if (schema >= 2) {
    groups = [
      { key: 'quality', tags: tagList(m.qualityTags) },
      { key: 'work', tags: tagList(m.workTags) },
      { key: 'character', tags: tagList(m.characterTags) },
      { key: 'type', tags: tagList(m.typeTags) },
    ];
  } else if (schema === 1) {
    groups = [
      { key: 'quality', tags: tagList(m.qualityTags) },
      { key: 'character', tags: tagList(m.characterTags) },
    ];
  } else {
    groups = [];
  }
  groups = groups.filter(function (g) { return g.tags.length > 0; });
  const useFlat = groups.length === 0;
  const flatTags = useFlat ? tagList(m.tags) : [];

  const hasDate = !!displayDate;
  const hasSource = !!sourceUrl;
  const hasTags = groups.length > 0 || flatTags.length > 0;
  const hasAny = hasDate || hasTags || hasSource;

  function renderTag(t) {
    const label = t.name != null ? String(t.name) : '';
    const href = t.href != null ? String(t.href) : '';
    if (!label && !href) return '';
    const inner = href
      ? `<a href="${esc(href)}" target="_blank" rel="noopener noreferrer">${esc(label)}</a>`
      : esc(label);
    return `<span class="anihonet-tagst">#${inner}</span>`;
  }
%>
<% if (!hasAny) { %>
<p id="anihonet-desc-empty" class="anihonet-desc-empty" style="font-size:0.875rem;opacity:0.75;"></p>
<% } else { %>
<style>
.anihonet-desc-wrap {
  unicode-bidi: isolate;
  font-size: 0.875rem;
  line-height: 1.55;
  color: inherit;
  box-sizing: border-box;
}
.anihonet-desc-wrap * { box-sizing: border-box; }
.anihonet-desc-wrap .anihonet-blogbox {
  margin: 0;
  padding: 0.65rem 0.75rem;
  border-radius: 8px;
  background: color-mix(in srgb, var(--anime-text-primary, currentColor) 6%, transparent);
  border: 1px solid color-mix(in srgb, var(--anime-text-primary, currentColor) 12%, transparent);
}
.anihonet-desc-wrap .anihonet-blogbox p {
  margin: 0;
}
.anihonet-desc-wrap .anihonet-kdate {
  display: inline;
  margin-right: 0.25rem;
}
.anihonet-desc-wrap .anihonet-tagst {
  display: inline;
  margin-right: 0.35rem;
}
.anihonet-desc-wrap .anihonet-source {
  display: inline;
  margin-right: 0.5rem;
}
.anihonet-desc-wrap .anihonet-tagst a,
.anihonet-desc-wrap .anihonet-source a {
  color: var(--anime-primary, #a78bfa);
  text-decoration: none;
}
.anihonet-desc-wrap .anihonet-tagst a:hover,
.anihonet-desc-wrap .anihonet-source a:hover {
  text-decoration: underline;
}
.anihonet-desc-wrap .anihonet-date-br {
  display: block;
  height: 0.35rem;
}
.anihonet-desc-wrap .anihonet-tag-group {
  display: block;
  margin-top: 0.3rem;
}
.anihonet-desc-wrap .anihonet-group-label {
  display: inline;
  margin-right: 0.35rem;
  font-weight: 600;
  opacity: 0.7;
}
</style>
<div class="anihonet-desc-wrap" id="anihonet-desc-root">
  <div class="anihonet-blogbox clearfix" data-anihonet-panel="1" aria-label="">
    <p>
      <% if (hasDate) { %>
      <span class="anihonet-kdate">
        <span data-anihonet-lbl="posted"></span><time datetime="<%= esc(rawDate) %>"><%= esc(displayDate) %></time>
      </span>
      <% } %>
      <% if (hasSource) { %>
      <span class="anihonet-source">
        <span data-anihonet-lbl="source"></span><a href="<%= esc(sourceUrl) %>" target="_blank" rel="noopener noreferrer"><%= esc(sourceText) %></a>
      </span>
      <% } %>
      <% if ((hasDate || hasSource) && hasTags) { %>
      <span class="anihonet-date-br" aria-hidden="true"></span>
      <% } %>
      <% if (useFlat) { %>
      <% flatTags.forEach(function (t) { %><%- renderTag(t) %><% }); %>
      <% } else { %>
      <% groups.forEach(function (g) { %>
      <span class="anihonet-tag-group">
        <span class="anihonet-group-label" data-anihonet-group="<%= g.key %>"></span><% g.tags.forEach(function (t) { %><%- renderTag(t) %><% }); %>
      </span>
      <% }); %>
      <% } %>
    </p>
  </div>
</div>
<% } %>
<script>
(function () {
  function anihonetLabels(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'zhtw') {
      return {
        posted: '投稿日：',
        source: '源帖：',
        panelAria: 'anihonet 投稿資訊',
        empty: '尚無 anihonet 元資料（請以最新版外掛重新抓取）。',
        groups: { quality: '畫質：', work: '作品：', character: '角色：', type: '種類：' }
      };
    }
    if (s === 'zh' || (s.indexOf('zh') === 0 && s.indexOf('tw') < 0)) {
      return {
        posted: '投稿日：',
        source: '源帖：',
        panelAria: 'anihonet 投稿信息',
        empty: '暂无 anihonet 元数据（请使用最新版插件重新抓取）。',
        groups: { quality: '画质：', work: '作品：', character: '角色：', type: '种类：' }
      };
    }
    if (s === 'ja') {
      return {
        posted: '投稿日：',
        source: '投稿元：',
        panelAria: 'anihonet 投稿メタデータ',
        empty: 'anihonet のメタデータがありません（最新版プラグインで再取得してください）。',
        groups: { quality: '画質：', work: '作品：', character: 'キャラ：', type: '種類：' }
      };
    }
    if (s === 'ko') {
      return {
        posted: '게시일：',
        source: '원본 게시글：',
        panelAria: 'anihonet 게시 메타데이터',
        empty: 'anihonet 메타데이터가 없습니다(최신 플러그인으로 다시 수집하세요).',
        groups: { quality: '화질: ', work: '작품: ', character: '캐릭터: ', type: '종류: ' }
      };
    }
    return {
      posted: 'Posted: ',
      source: 'Source: ',
      panelAria: 'anihonet post metadata',
      empty: 'No anihonet metadata (re-crawl with the latest plugin).',
      groups: { quality: 'Quality: ', work: 'Work: ', character: 'Character: ', type: 'Type: ' }
    };
  }
  function apply(loc) {
    var L = anihonetLabels(loc);
    var posted = document.querySelector('[data-anihonet-lbl="posted"]');
    if (posted && L.posted) posted.textContent = L.posted;
    var source = document.querySelector('[data-anihonet-lbl="source"]');
    if (source && L.source) source.textContent = L.source;
    var panel = document.querySelector('[data-anihonet-panel="1"]');
    if (panel && L.panelAria) panel.setAttribute('aria-label', L.panelAria);
    var emptyEl = document.getElementById('anihonet-desc-empty');
    if (emptyEl && L.empty) emptyEl.textContent = L.empty;
    var groupLabels = L.groups || {};
    var groupEls = document.querySelectorAll('[data-anihonet-group]');
    for (var i = 0; i < groupEls.length; i++) {
      var key = groupEls[i].getAttribute('data-anihonet-group');
      if (key && groupLabels[key]) groupEls[i].textContent = groupLabels[key];
    }
  }
  function onReady() {
    if (window.__bridge && window.__bridge.getLocale) {
      window.__bridge.getLocale().then(apply).catch(function () {
        apply('en');
      });
    } else {
      apply((navigator.language || 'en').split('-')[0]);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
  else onReady();
})();
</script>
