<% const m = metadata || {}; %>
<% const pdComments = Array.isArray(m.comments) ? m.comments : []; %>
<%
  let frameUrl = '';
  const author = m.author;
  if (author && author.activeDecorations && Array.isArray(author.activeDecorations)) {
    for (let i = 0; i < author.activeDecorations.length; i++) {
      const rel = author.activeDecorations[i];
      const dec = rel && rel.decoration;
      if (dec && dec.type === 'AVATAR_FRAME' && dec.data && dec.data.assetUrl) {
        frameUrl = dec.data.assetUrl;
        break;
      }
    }
  }
  const displayName = (author && author.displayName) ? String(author.displayName) : '';
  const username = (author && author.username) ? String(author.username) : '';
  const avatarUrl = (author && author.avatarSmallThumbnailMediaUrl) ? String(author.avatarSmallThumbnailMediaUrl) : '';
  const authorHref = username ? ('https://pixai.art/@' + encodeURIComponent(username) + '/artworks') : '';
  const artworkId = m.id ? String(m.id) : '';
  const artworkHref = artworkId ? ('https://pixai.art/artwork/' + artworkId) : '';
  let initial = '?';
  const s0 = displayName || username;
  if (s0 && s0.length > 0) initial = s0.charAt(0);
%>
<style>
@keyframes pd-spin{to{transform:rotate(360deg)}}
.pd-expand{margin-bottom:10px}
.pd-expand-viewport{position:relative;overflow:hidden;transition:max-height 0.22s ease}
.pd-expand.is-collapsed:not(.pd-no-clamp) .pd-expand-viewport{max-height:var(--pd-clamp-max,2.32rem)}
.pd-expand.pd-no-clamp .pd-expand-viewport,
.pd-expand.is-expanded .pd-expand-viewport{max-height:none}
.pd-expand.is-collapsed:not(.pd-no-clamp) .pd-expand-viewport::after{
  content:'';
  position:absolute;left:0;right:0;bottom:0;height:1.35em;pointer-events:none;
  background:linear-gradient(to bottom,rgba(255,255,255,0),var(--anime-bg-card,rgba(255,255,255,0.96)));
  backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);
}
.pd-expand-toggle{
  display:none;box-sizing:border-box;width:100%;justify-content:center;align-items:center;gap:3px;margin-top:2px;
  font-size:0.72rem;line-height:1.35;color:var(--anime-primary,#6366f1);cursor:pointer;user-select:none;
  text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:2px
}
.pd-expand-toggle:hover{opacity:0.88}
.pd-expand-toggle:focus-visible{outline:2px solid var(--anime-primary,#6366f1);outline-offset:2px;border-radius:2px}
.pd-expand-chev{flex-shrink:0;display:inline-flex;transition:transform 0.18s ease;vertical-align:middle}
.pd-expand-toggle[aria-expanded="true"] .pd-expand-chev{transform:rotate(180deg)}
</style>
<div style="font-size:0.875rem;color:var(--anime-text-primary,#1f2937);line-height:1.45;">
  <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
    <div style="position:relative;width:2.75rem;height:2.75rem;flex-shrink:0;">
      <div style="position:absolute;inset:0;border-radius:50%;overflow:hidden;z-index:1;">
        <% if (avatarUrl) { %>
          <img src="<%= avatarUrl %>" alt="" style="width:100%;height:100%;object-fit:cover;display:block;max-height:none;" />
        <% } else { %>
          <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#60a5fa,#3b82f6);color:#fff;font-weight:600;font-size:0.8rem;"><%= initial %></div>
        <% } %>
      </div>
      <% if (frameUrl) { %>
        <img src="<%= frameUrl %>" alt="" style="position:absolute;left:0;top:0;width:100%;height:100%;object-fit:contain;transform:scale(1.25);transform-origin:center center;pointer-events:none;max-height:none;z-index:2;" />
      <% } %>
    </div>
    <div style="min-width:0;flex:1;">
      <% if (authorHref && displayName) { %>
        <a href="#" class="pd-open" data-url="<%= authorHref %>" rel="noopener noreferrer" style="font-weight:600;color:var(--anime-text-primary,#1f2937);text-decoration:none;cursor:pointer;"><%= displayName %></a>
      <% } else { %>
        <%= displayName %>
      <% } %>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:10px;font-size:0.85rem;color:var(--anime-text-secondary,#6b7280);width:100%;">
    <span style="display:inline-flex;align-items:center;gap:4px;">
      <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="width:1.2em;height:1.2em;vertical-align:middle;display:inline-block;color:var(--anime-text-secondary,#6b7280)"><g fill="none"><path d="m12.593 23.258l-.011.002l-.071.035l-.02.004l-.014-.004l-.071-.035q-.016-.005-.024.005l-.004.01l-.017.428l.005.02l.01.013l.104.074l.015.004l.012-.004l.104-.074l.012-.016l.004-.017l-.017-.427q-.004-.016-.017-.018m.265-.113l-.013.002l-.185.093l-.01.01l-.003.011l.018.43l.005.012l.008.007l.201.093q.019.005.029-.008l.004-.014l-.034-.614q-.005-.018-.02-.022m-.715.002a.02.02 0 0 0-.027.006l-.006.014l-.034.614q.001.018.017.024l.015-.002l.201-.093l.01-.008l.004-.011l.017-.43l-.003-.012l-.01-.01z"></path><path fill="currentColor" d="M18.494 3.801c2.095 1.221 3.569 3.7 3.504 6.592C21.86 16.5 13.5 21 12 21s-9.861-4.5-9.998-10.607c-.065-2.892 1.409-5.37 3.504-6.592C7.466 2.66 9.928 2.653 12 4.338c2.072-1.685 4.534-1.679 6.494-.537"></path></g></svg>
      <span><%= m.likedCount != null ? m.likedCount : '0' %></span>
    </span>
    <span style="display:inline-flex;align-items:center;gap:4px;">&#128172;<span><%= m.commentCount != null ? m.commentCount : '0' %></span></span>
    <% if (artworkHref) { %>
      <a href="#" class="pd-open" data-url="<%= artworkHref %>" rel="noopener noreferrer" style="font-size:0.8rem;color:var(--anime-primary,#6366f1);margin-left:auto;cursor:pointer;text-decoration:underline;">PixAI</a>
    <% } %>
  </div>
  <% if (m.extra && m.extra.description) { %>
    <div class="pd-expand is-collapsed" data-pd-expand style="--pd-clamp-max:2.32rem;">
      <div class="pd-expand-viewport">
        <div class="pd-expand-content" style="font-size:0.8rem;color:var(--anime-text-secondary,#4b5563);word-break:break-word;line-height:1.45;"><%= m.extra.description %></div>
      </div>
      <span class="pd-expand-toggle" role="button" tabindex="0" aria-expanded="false">
        <span class="pd-expand-chev" aria-hidden="true"><svg viewBox="0 0 20 20" width="0.85em" height="0.85em"><path fill="currentColor" d="M15.794 7.733a.75.75 0 0 1-.026 1.06l-5.25 5.001a.75.75 0 0 1-1.035 0l-5.25-5a.75.75 0 0 1 1.034-1.087l4.734 4.509l4.733-4.51a.75.75 0 0 1 1.06.027"></path></svg></span>
        <span class="pd-expand-label"></span>
      </span>
    </div>
  <% } %>
  <% if (m.extra && (m.extra.naturalPrompts || m.prompts)) { %>
    <div class="pd-expand is-collapsed" data-pd-expand style="--pd-clamp-max:2.32rem;">
      <div class="pd-expand-viewport">
        <div class="pd-expand-content" style="font-size:0.8rem;color:var(--anime-text-secondary,#4b5563);line-height:1.45;word-break:break-word;"><%= m.extra.naturalPrompts || m.prompts %></div>
      </div>
      <span class="pd-expand-toggle" role="button" tabindex="0" aria-expanded="false">
        <span class="pd-expand-chev" aria-hidden="true"><svg viewBox="0 0 20 20" width="0.85em" height="0.85em"><path fill="currentColor" d="M15.794 7.733a.75.75 0 0 1-.026 1.06l-5.25 5.001a.75.75 0 0 1-1.035 0l-5.25-5a.75.75 0 0 1 1.034-1.087l4.734 4.509l4.733-4.51a.75.75 0 0 1 1.06.027"></path></svg></span>
        <span class="pd-expand-label"></span>
      </span>
    </div>
  <% } %>
  <% if (m.extra && m.extra.suggestedTacks && m.extra.suggestedTacks.length) { %>
  <div class="pd-expand is-collapsed" data-pd-expand id="tags-expand-wrap" style="margin-bottom:12px;--pd-clamp-max:3.35rem;">
    <div class="pd-expand-viewport">
      <div id="tags-container" class="pd-expand-content" style="min-height:1.5em;color:var(--anime-text-secondary,#6b7280);font-size:0.8rem;">…</div>
    </div>
    <span class="pd-expand-toggle" role="button" tabindex="0" aria-expanded="false">
      <span class="pd-expand-chev" aria-hidden="true"><svg viewBox="0 0 20 20" width="0.85em" height="0.85em"><path fill="currentColor" d="M15.794 7.733a.75.75 0 0 1-.026 1.06l-5.25 5.001a.75.75 0 0 1-1.035 0l-5.25-5a.75.75 0 0 1 1.034-1.087l4.734 4.509l4.733-4.51a.75.75 0 0 1 1.06.027"></path></svg></span>
      <span class="pd-expand-label"></span>
    </span>
  </div>
  <% } %>
  <div id="comments-container" style="margin-bottom:8px;">
    <% for (let pdci = 0; pdci < pdComments.length; pdci++) { const pdcn = pdComments[pdci]; const pdcAu = pdcn.author || {}; const pdcName = pdcAu.displayName || pdcAu.username || '?'; const pdcAvatar = pdcAu.avatarSmallThumbnailMediaUrl || ''; const pdcTime = pdcn.createdAt ? String(pdcn.createdAt).slice(0, 16).replace('T', ' ') : ''; %>
    <div style="margin-bottom:10px;padding-bottom:10px;border-bottom:1px solid color-mix(in srgb,var(--anime-border,#e5e7eb) 45%,transparent);">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;font-size:0.75rem;color:var(--anime-text-secondary,#6b7280);">
        <% if (pdcAvatar) { %><img src="<%= pdcAvatar %>" alt="" style="width:24px;height:24px;border-radius:50%;object-fit:cover;flex-shrink:0;" /><% } %>
        <span style="font-weight:600;color:var(--anime-text-primary,#1f2937);"><%= pdcName %></span>
        <span><%= pdcTime %></span>
      </div>
      <div style="font-size:0.8rem;color:var(--anime-text-primary,#1f2937);white-space:pre-wrap;word-break:break-word;"><%= pdcn.type === 'TEXT' && pdcn.content != null ? String(pdcn.content) : '' %></div>
    </div>
    <% } %>
    <% if (!pdComments.length) { %><p style="font-size:0.8rem;color:var(--anime-text-secondary,#9ca3af);margin:4px 0;">No comments</p><% } %>
  </div>
</div>
<script>
(function () {
  function pdCssVar(name, fallback) {
    var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  var GRAPHQL = 'https://api.pixai.art/graphql';
  var GET_TACK_EXT = {"clientLibrary":{"name":"@apollo/client","version":"4.1.4"},"persistedQuery":{"version":1,"sha256Hash":"4517f9180265ab50f2cf3a92f33d146b957c8d73ed165ef39b4bb8ec927bf813"}};
  var TACK_IDS = <%- JSON.stringify((m.extra && m.extra.suggestedTacks) ? m.extra.suggestedTacks : []) %>;

  function gql(op, vars, ext) {
    var h = {
      'Accept': 'application/json',
      'Content-Type': 'application/json',
      'x-apollo-operation-name': op,
      'Origin': 'https://pixai.art',
      'Referer': 'https://pixai.art/'
    };
    var url = GRAPHQL + '?operation=' + encodeURIComponent(op) + '&operationName=' + encodeURIComponent(op)
      + '&variables=' + encodeURIComponent(JSON.stringify(vars))
      + '&extensions=' + encodeURIComponent(JSON.stringify(ext));
    return window.__bridge.fetch(url, { headers: h, json: true });
  }

  function pdExpandLabels(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'zhtw') return { show: '顯示全部', less: '收起' };
    if (s === 'zh' || (s.indexOf('zh') === 0 && s.indexOf('tw') < 0))
      return { show: '显示全部', less: '收起' };
    if (s === 'ja') return { show: 'すべて表示', less: '閉じる' };
    if (s === 'ko') return { show: '전체 보기', less: '접기' };
    return { show: 'Show all', less: 'Show less' };
  }

  function pdUpdateExpandToggle(wrap, loc) {
    var t = wrap && wrap.querySelector('.pd-expand-toggle');
    if (!t) return;
    var lab = t.querySelector('.pd-expand-label');
    var L = pdExpandLabels(loc);
    var exp = wrap.classList.contains('is-expanded');
    t.setAttribute('aria-expanded', exp ? 'true' : 'false');
    if (lab) lab.textContent = exp ? L.less : L.show;
  }

  function pdRefreshExpand(wrap) {
    if (!wrap || !wrap.querySelector) return;
    var view = wrap.querySelector('.pd-expand-viewport');
    var t = wrap.querySelector('.pd-expand-toggle');
    if (!view || !t) return;
    if (wrap.classList.contains('is-expanded')) {
      t.style.display = 'flex';
      return;
    }
    wrap.classList.remove('pd-no-clamp');
    wrap.classList.add('is-collapsed');
    var needs = view.scrollHeight > view.clientHeight + 2;
    if (!needs) {
      wrap.classList.remove('is-collapsed');
      wrap.classList.add('pd-no-clamp');
      t.style.display = 'none';
    } else {
      t.style.display = 'flex';
    }
  }

  function pdBindAllExpands(loc) {
    var nodes = document.querySelectorAll('[data-pd-expand]');
    for (var i = 0; i < nodes.length; i++) {
      (function (wrap) {
        var t = wrap.querySelector('.pd-expand-toggle');
        if (!t || t.getAttribute('data-pd-bound') === '1') return;
        t.setAttribute('data-pd-bound', '1');
        function toggle() {
          if (wrap.classList.contains('is-expanded')) {
            wrap.classList.remove('is-expanded');
            wrap.classList.add('is-collapsed');
            pdRefreshExpand(wrap);
            pdUpdateExpandToggle(wrap, loc);
          } else {
            wrap.classList.remove('is-collapsed', 'pd-no-clamp');
            wrap.classList.add('is-expanded');
            t.style.display = 'flex';
            pdUpdateExpandToggle(wrap, loc);
          }
        }
        t.addEventListener('click', toggle);
        t.addEventListener('keydown', function (ev) {
          var k = ev.key;
          if (k === 'Enter' || k === ' ') {
            ev.preventDefault();
            toggle();
          }
        });
      })(nodes[i]);
      pdRefreshExpand(nodes[i]);
      pdUpdateExpandToggle(nodes[i], loc);
    }
  }

  function tackLocalePrefs(appLocale) {
    var s = String(appLocale || 'en').toLowerCase();
    if (s === 'zhtw') return ['zh-TW', 'zh', 'zh-Hant', 'zh-Hans', 'en'];
    if (s === 'zh' || (s.indexOf('zh') === 0 && s.indexOf('tw') < 0))
      return ['zh', 'zh-CN', 'zh-Hans', 'zh-TW', 'zh-Hant', 'en'];
    if (s === 'ja') return ['ja', 'en'];
    if (s === 'ko') return ['ko', 'en'];
    if (s === 'en') return ['en', 'ja', 'zh', 'ko'];
    return [s, 'en'];
  }

  function pickTackName(tack, appLocale) {
    var terms = tack.tackTerms || [];
    var prefs = tackLocalePrefs(appLocale);
    var i, j;
    for (j = 0; j < prefs.length; j++) {
      var p = prefs[j];
      for (i = 0; i < terms.length; i++) {
        if (terms[i].category === p) return terms[i].name;
      }
    }
    for (i = 0; i < terms.length; i++) {
      if (terms[i].category === 'en') return terms[i].name;
    }
    if (terms.length > 0) return terms[0].name;
    return tack.defaultName || tack.codeName || '';
  }

  function loadTacks(appLocale) {
    var el = document.getElementById('tags-container');
    if (!el) return;
    if (!TACK_IDS || TACK_IDS.length === 0) {
      el.textContent = '';
      return;
    }
    var max = Math.min(15, TACK_IDS.length);
    var slice = TACK_IDS.slice(0, max);
    var results = [];
    function renderTags() {
      el.innerHTML = '';
      el.style.display = 'flex';
      el.style.flexWrap = 'wrap';
      el.style.gap = '6px';
      results.forEach(function (tack) {
        var name = pickTackName(tack, appLocale);
        var code = tack.codeName || '';
        var span = document.createElement('span');
        var pillBg = 'color-mix(in srgb, ' + pdCssVar('--anime-primary', '#6366f1') + ' 18%, transparent)';
        var pillFg = pdCssVar('--anime-primary', '#4f46e5');
        span.style.cssText = 'display:inline-block;padding:2px 8px;border-radius:999px;background:' + pillBg + ';color:' + pillFg + ';font-size:0.75rem;';
        if (code) {
          var tagUrl = 'https://pixai.art/tags/artwork/' + encodeURIComponent(code);
          var a = document.createElement('a');
          a.href = '#';
          a.className = 'pd-open';
          a.setAttribute('data-url', tagUrl);
          a.rel = 'noopener noreferrer';
          a.style.cssText = 'color:inherit;text-decoration:none;cursor:pointer;';
          a.textContent = name;
          span.appendChild(a);
        } else {
          span.textContent = name;
        }
        el.appendChild(span);
      });
      var tw = document.getElementById('tags-expand-wrap');
      if (tw) {
        tw.classList.remove('is-expanded', 'pd-no-clamp');
        tw.classList.add('is-collapsed');
        pdRefreshExpand(tw);
        pdUpdateExpandToggle(tw, appLocale);
      }
    }
    function chunk(start) {
      if (start >= slice.length) {
        renderTags();
        return;
      }
      var end = Math.min(start + 6, slice.length);
      var chunkIds = slice.slice(start, end);
      Promise.all(chunkIds.map(function (id) {
        return gql('getTack', { id: id }, GET_TACK_EXT).then(function (json) {
          var tack = json && json.data && json.data.tack;
          return tack || null;
        }).catch(function () { return null; });
      })).then(function (parts) {
        parts.forEach(function (t) { if (t) results.push(t); });
        chunk(end);
      });
    }
    chunk(0);
  }

  function onReady() {
    function startWithLocale(loc) {
      var appLocale = loc || 'en';
      pdBindAllExpands(appLocale);
      loadTacks(appLocale);
    }
    if (window.__bridge && window.__bridge.getLocale) {
      window.__bridge.getLocale().then(startWithLocale).catch(function () {
        startWithLocale('en');
      });
    } else {
      startWithLocale((navigator.language || 'en').split('-')[0]);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
  else onReady();
})();
</script>
