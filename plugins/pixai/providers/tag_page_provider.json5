{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.pixai",
  "name": "tag_page_provider",
  "properties": {
    "page_num": { "type": "number", "default": 1, "optional": false },
    "page_tags_json": { "type": "string", "default": "[]", "optional": true }
  },
  "query": {
    "where": "EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(pixai_tags) THEN pixai_tags ELSE json('[]') END) AS image_tag WHERE COALESCE(NULLIF(TRIM(CAST(json_extract(image_tag.value, '$.codeName') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(image_tag.value, '$.id') AS TEXT)), '')) IN (SELECT COALESCE(NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.tag_key') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.display_name') AS TEXT)), '')) FROM json_each(CASE WHEN json_valid(${properties.page_tags_json}) THEN ${properties.page_tags_json} ELSE json('[]') END) AS page_tag WHERE COALESCE(NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.tag_key') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(page_tag.value, '$.display_name') AS TEXT)), '')) IS NOT NULL))"
  },
  "list": {
    "${tag.display_name}": {
      "sql": "SELECT COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag_key') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.display_name') AS TEXT)), '')) AS tag_key, COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.display_name') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag_key') AS TEXT)), '')) AS display_name, CAST(json_extract(tag.value, '$.image_count') AS INTEGER) AS image_count FROM json_each(CASE WHEN json_valid(${properties.page_tags_json}) THEN ${properties.page_tags_json} ELSE json('[]') END) AS tag WHERE COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag_key') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.display_name') AS TEXT)), '')) IS NOT NULL ORDER BY CAST(tag.key AS INTEGER)",
      "data_var": "tag",
      "provider": "tag_provider",
      "properties": {
        "tag_key": "${tag.tag_key}"
      },
      "meta": {
        "isLeaf": true,
        "display": "${tag.display_name}",
        "image_count": "${tag.image_count}"
      }
    }
  }
}
