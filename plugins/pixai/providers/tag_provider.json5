{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.pixai",
  "name": "tag_provider",
  "properties": {
    "tag_key": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(pixai_tags) THEN pixai_tags ELSE json('[]') END) AS tag WHERE COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.codeName') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.id') AS TEXT)), '')) = ${properties.tag_key} OR COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.displayName') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.defaultName') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.codeName') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.id') AS TEXT)), '')) = ${properties.tag_key})"
  },
  "list": {
    "${out.name}": {
          "child_var": "out",
          "delegate": {
              "provider": "kabegame.paginate100_provider",
          },
          "provider": "${out.provider}",
          "meta": "${out.meta}"
      }
  },
  "resolve": {
    "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
      "delegate": {
        "provider": "kabegame.gallery_desc_pagination_page_comb"
      },
      "child_var": "child",
      "provider": "${child.provider}",
      "meta": "${child.meta}"
    }
  }
}
