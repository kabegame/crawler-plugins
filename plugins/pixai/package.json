{
  "name": "pixai",
  "version": "0.4.2",
  "private": true,
  "name.zh": "PixAI",
  "name.en": "PixAI",
  "name.ja": "PixAI",
  "name.ko": "PixAI",
  "description": "PixAI AI art community crawler: trending models and artworks. In many cases the quality can surpass Pixiv.",
  "description.zh": "PixAI AI 画像社区爬虫：遍历趋势模型与作品。某种意义上作品质量常优于 Pixiv。",
  "description.en": "PixAI AI art community crawler: trending models and artworks. In many cases the quality can surpass Pixiv.",
  "description.ja": "PixAI AI画像コミュニティ：トレンドモデルと作品を取得。ある意味で Pixiv より高品質な作品が多い場合があります。",
  "description.ko": "PixAI AI 이미지 커뮤니티: 트렌드 모델과 작품을 수집합니다. 어떤 의미에서 Pixiv보다 품질이 나은 경우가 많습니다.",
  "author": "Kabegame",
  "kbPackageVersion": 3,
  "engines": {
    "kabegame": ">=4.3.0"
  },
  "main": "dist/main.js",
  "kbBackend": "v8",
  "scripts": {
    "build": "rspack build"
  },
  "kbBaseUrl": "https://pixai.art",
  "kbLabels": [
    { "id": "auth.needProxy" },
    { "id": "content.type.video" }
  ],
  "kbConfig": [
    {
      "key": "crawl_type",
      "type": "options",
      "name": "爬取种类",
      "name.en": "Crawl Type",
      "name.ja": "取得種類",
      "name.ko": "크롤링 유형",
      "default": "global",
      "options": [
        {
          "name": "全站",
          "name.en": "Global",
          "name.ja": "全サイト",
          "name.ko": "전체",
          "variable": "global"
        },
        {
          "name": "按模型",
          "name.en": "By Model",
          "name.ja": "モデル別",
          "name.ko": "모델별",
          "variable": "model"
        },
        {
          "name": "按标签",
          "name.en": "By Tag",
          "name.ja": "タグ別",
          "name.ko": "태그별",
          "variable": "tag"
        },
        {
          "name": "排行榜",
          "name.en": "Ranking",
          "name.ja": "ランキング",
          "name.ko": "랭킹",
          "variable": "ranking"
        },
        {
          "name": "按作者",
          "name.en": "By Author",
          "name.ja": "作者別",
          "name.ko": "작가별",
          "variable": "author"
        }
      ]
    },
    {
      "key": "rank_type",
      "type": "options",
      "name": "榜单类型",
      "name.en": "Rank Type",
      "name.ja": "ランキング種類",
      "name.ko": "랭킹 유형",
      "default": "artwork",
      "options": [
        {
          "name": "作品",
          "name.en": "Artwork",
          "name.ja": "作品",
          "name.ko": "작품",
          "variable": "artwork"
        },
        {
          "name": "うごイラ (动图)",
          "name.en": "Animated",
          "name.ja": "うごイラ",
          "name.ko": "움직이는 일러스트",
          "variable": "animated"
        },
        {
          "name": "SD 模型",
          "name.en": "SD Model",
          "name.ja": "SDモデル",
          "name.ko": "SD 모델",
          "variable": "model"
        },
        {
          "name": "LoRA",
          "name.en": "LoRA",
          "name.ja": "LoRA",
          "name.ko": "LoRA",
          "variable": "lora"
        }
      ],
      "when": {
        "crawl_type": [
          "ranking"
        ]
      }
    },
    {
      "key": "rank_period",
      "type": "options",
      "name": "榜单范围",
      "name.en": "Rank Period",
      "name.ja": "ランキング期間",
      "name.ko": "랭킹 기간",
      "default": "today",
      "options": [
        {
          "name": "今日",
          "name.en": "Today",
          "name.ja": "今日",
          "name.ko": "오늘",
          "variable": "today"
        },
        {
          "name": "本周",
          "name.en": "Weekly",
          "name.ja": "週間",
          "name.ko": "주간",
          "variable": "weekly"
        },
        {
          "name": "本月",
          "name.en": "Monthly",
          "name.ja": "月間",
          "name.ko": "월간",
          "variable": "monthly"
        }
      ],
      "when": {
        "crawl_type": [
          "ranking"
        ]
      }
    },
    {
      "key": "max_artwork_pages_ranking",
      "type": "int",
      "name": "每个上榜模型作品分页数",
      "name.en": "Artwork Pages per Ranked Model",
      "name.ja": "ランクインモデルごとの作品ページ数",
      "name.ko": "랭킹 모델당 작품 페이지 수",
      "default": 1,
      "min": 1,
      "max": 50,
      "when": {
        "crawl_type": [
          "ranking"
        ],
        "rank_type": [
          "model",
          "lora"
        ]
      }
    },
    {
      "key": "model_sort",
      "type": "options",
      "name": "模型排序",
      "name.en": "Model Sort",
      "name.ja": "モデル並び順",
      "name.ko": "모델 정렬",
      "default": "trending",
      "options": [
        {
          "name": "趋势",
          "name.en": "Trending",
          "name.ja": "トレンド",
          "name.ko": "트렌딩",
          "variable": "trending"
        },
        {
          "name": "人气（高到低）",
          "name.en": "Popular (Desc)",
          "name.ja": "人気（高→低）",
          "name.ko": "인기순(내림차순)",
          "variable": "popular_desc"
        },
        {
          "name": "人气（低到高）",
          "name.en": "Popular (Asc)",
          "name.ja": "人気（低→高）",
          "name.ko": "인기순(오름차순)",
          "variable": "popular_asc"
        },
        {
          "name": "生成人气（高到低）",
          "name.en": "Generated Popular (Desc)",
          "name.ja": "生成人気（高→低）",
          "name.ko": "생성 인기순(내림차순)",
          "variable": "gen_popular_desc"
        },
        {
          "name": "生成人气（低到高）",
          "name.en": "Generated Popular (Asc)",
          "name.ja": "生成人気（低→高）",
          "name.ko": "생성 인기순(오름차순)",
          "variable": "gen_popular_asc"
        },
        {
          "name": "最新（新到旧）",
          "name.en": "Latest (Desc)",
          "name.ja": "最新（新→旧）",
          "name.ko": "최신순(내림차순)",
          "variable": "latest_desc"
        },
        {
          "name": "最新（旧到新）",
          "name.en": "Latest (Asc)",
          "name.ja": "最新（旧→新）",
          "name.ko": "최신순(오름차순)",
          "variable": "latest_asc"
        }
      ],
      "when": {
        "crawl_type": [
          "model"
        ]
      }
    },
    {
      "key": "max_model_pages",
      "type": "int",
      "name": "模型分页数",
      "default": 3,
      "min": 1,
      "max": 50,
      "when": {
        "crawl_type": [
          "model"
        ]
      }
    },
    {
      "key": "skip_model_pages",
      "type": "int",
      "name": "跳过模型页数",
      "name.en": "Skip Model Pages",
      "name.ja": "スキップするモデルページ数",
      "name.ko": "건너뛸 모델 페이지 수",
      "descripts": "从第 N+1 页开始处理模型（前 N 页仅翻页不下载）",
      "descripts.en": "Start processing models from page N+1 (first N pages only advance cursor, no downloads)",
      "descripts.ja": "N+1 ページ目からモデルを処理します（最初の N ページはカーソル進行のみ、ダウンロードなし）",
      "descripts.ko": "N+1 페이지부터 모델 처리(앞 N 페이지는 커서 이동만, 다운로드 없음)",
      "default": 0,
      "min": 0,
      "max": 49,
      "when": {
        "crawl_type": [
          "model"
        ]
      }
    },
    {
      "key": "artwork_sort",
      "type": "options",
      "name": "作品排序",
      "name.en": "Artwork Sort",
      "name.ja": "作品並び順",
      "name.ko": "작품 정렬",
      "default": "trending",
      "options": [
        {
          "name": "趋势",
          "name.en": "Trending",
          "name.ja": "トレンド",
          "name.ko": "트렌딩",
          "variable": "trending"
        },
        {
          "name": "日榜",
          "name.en": "Daily Ranking",
          "name.ja": "日間ランキング",
          "name.ko": "일간 랭킹",
          "variable": "daily_ranking"
        },
        {
          "name": "人气（高到低）",
          "name.en": "Popular (Desc)",
          "name.ja": "人気（高→低）",
          "name.ko": "인기순(내림차순)",
          "variable": "popular_desc"
        },
        {
          "name": "最新",
          "name.en": "Latest",
          "name.ja": "最新",
          "name.ko": "최신",
          "variable": "latest"
        },
        {
          "name": "人气（低到高）",
          "name.en": "Popular (Asc)",
          "name.ja": "人気（低→高）",
          "name.ko": "인기순(오름차순)",
          "variable": "popular_asc"
        },
        {
          "name": "创建时间（旧到新）",
          "name.en": "Created Time (Asc)",
          "name.ja": "作成時間（旧→新）",
          "name.ko": "생성 시간(오름차순)",
          "variable": "created_asc"
        },
        {
          "name": "创建时间（新到旧）",
          "name.en": "Created Time (Desc)",
          "name.ja": "作成時間（新→旧）",
          "name.ko": "생성 시간(내림차순)",
          "variable": "created_desc"
        }
      ],
      "when": {
        "crawl_type": [
          "global",
          "model",
          "tag",
          "author"
        ]
      }
    },
    {
      "key": "author_id",
      "type": "string",
      "name": "作者 ID",
      "name.en": "Author ID",
      "name.ja": "作者 ID",
      "name.ko": "작가 ID",
      "descripts": "输入 PixAI 用户 ID（纯数字字符串，可在用户主页 URL 中找到）",
      "descripts.en": "Enter PixAI user ID (numeric string, can be found in user profile URL)",
      "descripts.ja": "PixAI ユーザー ID（数字文字列）を入力。ユーザーページ URL で確認できます",
      "descripts.ko": "PixAI 사용자 ID(숫자 문자열)를 입력하세요. 사용자 페이지 URL에서 확인할 수 있습니다",
      "default": "",
      "when": {
        "crawl_type": [
          "author"
        ]
      }
    },
    {
      "key": "author_artwork_type",
      "type": "options",
      "name": "爬取类型",
      "name.en": "Artwork Type",
      "name.ja": "取得タイプ",
      "name.ko": "작품 유형",
      "default": "image",
      "options": [
        {
          "name": "图片",
          "name.en": "Image",
          "name.ja": "画像",
          "name.ko": "이미지",
          "variable": "image"
        },
        {
          "name": "动图",
          "name.en": "Animated",
          "name.ja": "うごイラ",
          "name.ko": "움직이는 일러스트",
          "variable": "animated"
        }
      ],
      "when": {
        "crawl_type": [
          "author"
        ]
      }
    },
    {
      "key": "skip_artwork_pages",
      "type": "int",
      "name": "跳过作品页数",
      "name.en": "Skip Artwork Pages",
      "name.ja": "スキップする作品ページ数",
      "name.ko": "건너뛸 작품 페이지 수",
      "descripts": "每个模型/标签/全站从第 N+1 页开始下载（前 N 页仅翻页不下载）",
      "descripts.en": "For each model/tag/global stream, download from page N+1 (first N pages only advance cursor)",
      "descripts.ja": "各モデル/タグ/全サイトで N+1 ページ目からダウンロード（最初の N ページはカーソル進行のみ）",
      "descripts.ko": "모델/태그/전체 스트림 각각 N+1 페이지부터 다운로드(앞 N 페이지는 커서 이동만)",
      "default": 0,
      "min": 0,
      "max": 199,
      "when": {
        "crawl_type": [
          "global",
          "model",
          "tag",
          "author"
        ]
      }
    },
    {
      "key": "max_global_pages",
      "type": "int",
      "name": "全站作品分页数",
      "name.en": "Global Artwork Pages",
      "name.ja": "全サイト作品ページ数",
      "name.ko": "전체 작품 페이지 수",
      "default": 5,
      "min": 1,
      "max": 200,
      "when": {
        "crawl_type": [
          "global"
        ]
      }
    },
    {
      "key": "max_artwork_pages",
      "type": "int",
      "name": "每个模型作品分页数",
      "default": 1,
      "min": 1,
      "max": 50,
      "when": {
        "crawl_type": [
          "model"
        ]
      }
    },
    {
      "key": "tag_code_names",
      "type": "list",
      "name": "标签 codeName",
      "name.en": "Tag codeNames",
      "name.ja": "タグ codeName",
      "name.ko": "태그 codeName",
      "descripts": "输入 PixAI 标签的 codeName（如 spy_x_family、genshin_impact），可在 pixai.art 标签页 URL 中找到",
      "descripts.en": "Enter PixAI tag codeNames (e.g. spy_x_family, genshin_impact), found in pixai.art tag page URLs",
      "descripts.ja": "PixAI タグの codeName を入力（例: spy_x_family、genshin_impact）。pixai.art のタグページ URL で確認できます",
      "descripts.ko": "PixAI 태그 codeName 입력 (예: spy_x_family, genshin_impact). pixai.art 태그 페이지 URL에서 확인 가능",
      "default": [
        "genshin_impact",
        "honkai_star_rail",
        "stella_sora"
      ],
      "options": null,
      "when": {
        "crawl_type": [
          "tag"
        ]
      }
    },
    {
      "key": "max_tag_artwork_pages",
      "type": "int",
      "name": "每个标签作品分页数",
      "name.en": "Pages per Tag",
      "name.ja": "タグごとのページ数",
      "name.ko": "태그당 페이지 수",
      "default": 3,
      "min": 1,
      "max": 50,
      "when": {
        "crawl_type": [
          "tag"
        ]
      }
    },
    {
      "key": "max_author_artwork_pages",
      "type": "int",
      "name": "作者作品分页数",
      "name.en": "Pages per Author",
      "name.ja": "作者ごとのページ数",
      "name.ko": "작가당 페이지 수",
      "default": 5,
      "min": 1,
      "max": 200,
      "when": {
        "crawl_type": [
          "author"
        ]
      }
    }
  ],
  "kbIcon": "icon.png",
  "kbDoc": {
    "default": "doc_root/doc.md"
  },
  "kbRecommendedConfigs": [
    "configs/every-day-global.json",
    "configs/global-trending.json",
    "configs/model-trending.json",
    "configs/ranking-artwork-today.json",
    "configs/tag-mihoyo-trio.json"
  ],
  "kbPathQLProviders": [
    "providers/entry_provider.json5",
    "providers/tag_page_provider.json5",
    "providers/tag_provider.json5"
  ],
  "kbDescriptionTemplate": "templates/description.ejs"
}
