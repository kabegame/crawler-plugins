{
  "$schema": "./config.schema.json",
  "baseUrl": "https://2dwallpapers.com",
  "selector": null,
  "var": [
    {
      "key": "work_key",
      "type": "string",
      "name": "作品",
      "name.en": "Work",
      "name.ja": "作品",
      "name.ko": "작품",
      "name.zhtw": "作品",
      "descripts": "按作品名称匹配并抓取该作品的分页列表",
      "descripts.en": "Match a work by name and crawl that work's paginated list",
      "descripts.ja": "作品名で一致する作品のページ付き一覧を取得します",
      "descripts.ko": "작품 이름으로 일치하는 작품의 페이지 목록을 수집합니다",
      "descripts.zhtw": "依作品名稱匹配並抓取該作品的分頁列表",
      "default": "Genshin"
    },
    {
      "key": "start_page",
      "type": "int",
      "name": "起始页数",
      "name.en": "Start page",
      "name.ja": "開始ページ",
      "name.ko": "시작 페이지",
      "name.zhtw": "起始頁數",
      "descripts": "从该页开始抓取",
      "descripts.en": "Crawl starts from this page number",
      "descripts.ja": "このページ番号から取得を開始します",
      "descripts.ko": "이 페이지 번호부터 수집을 시작합니다",
      "descripts.zhtw": "從該頁開始抓取",
      "default": 1,
      "min": 1,
      "max": 200
    },
    {
      "key": "end_page",
      "type": "int",
      "name": "结束页数",
      "name.en": "End page",
      "name.ja": "終了ページ",
      "name.ko": "끝 페이지",
      "name.zhtw": "結束頁數",
      "descripts": "抓取到该页为止",
      "descripts.en": "Crawl up to this page",
      "descripts.ja": "このページまで取得します",
      "descripts.ko": "이 페이지까지 수집합니다",
      "descripts.zhtw": "抓取到該頁為止",
      "default": 10,
      "min": 1,
      "max": 200
    },
    {
      "key": "orderby",
      "type": "options",
      "name": "排序方式",
      "name.en": "Sort by",
      "name.ja": "並び順",
      "name.ko": "정렬 기준",
      "name.zhtw": "排序方式",
      "default": "date",
      "options": [
        { "name": "最新", "name.en": "Latest", "name.ja": "最新", "name.ko": "최신", "name.zhtw": "最新", "variable": "date" },
        { "name": "最多查看", "name.en": "Most views", "name.ja": "閲覧数順", "name.ko": "조회수순", "name.zhtw": "最多查看", "variable": "views" },
        { "name": "最多喜欢", "name.en": "Most likes", "name.ja": "いいね順", "name.ko": "좋아요순", "name.zhtw": "最多喜歡", "variable": "likes" },
        { "name": "最多收藏", "name.en": "Most saved", "name.ja": "保存数順", "name.ko": "저장순", "name.zhtw": "最多收藏", "variable": "follow_num" },
        { "name": "最近更新", "name.en": "Recently updated", "name.ja": "更新順", "name.ko": "최근 업데이트", "name.zhtw": "最近更新", "variable": "modified" },
        { "name": "随机", "name.en": "Random", "name.ja": "ランダム", "name.ko": "무작위", "name.zhtw": "隨機", "variable": "rand" }
      ]
    }
  ]
}
