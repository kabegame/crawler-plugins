{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.twodwallpapers",
  "name": "entry_provider",
  "list": {
    "${category.category_name}": {
      "sql": "SELECT NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{}' END, '$.category') AS TEXT)), '') AS category_name, COUNT(*) AS image_count FROM (SELECT plugin_metadata FROM (${composed}) AS composed_result GROUP BY plugin_metadata) AS source WHERE NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{}' END, '$.category') AS TEXT)), '') IS NOT NULL GROUP BY category_name ORDER BY image_count DESC, category_name ASC",
      "data_var": "category",
      "provider": "category_provider",
      "properties": {
        "category_name": "${category.category_name}"
      },
      "meta": {
        "isLeaf": true,
        "display": "${category.category_name}",
        "image_count": "${category.image_count}"
      }
    }
  },
  "resolve": {
    "([^/]+)": {
      "provider": "category_provider",
      "properties": {
        "category_name": "${capture[1]}"
      },
      "meta": {
        "isLeaf": true
      }
    }
  },
  "note": "{\"title\":\"2dwallpapers categories\",\"content\":\"Group 2dwallpapers images by category from plugin metadata.\"}"
}
