{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.twodwallpapers",
  "name": "category_provider",
  "properties": {
    "category_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, '$.category') AS TEXT)), '') = ${properties.category_name}), 0)"
  }
}
