{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.ziworld",
  "name": "directory_provider",
  "properties": {
    "directory_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((json_valid(plugin_im.data) AND NULLIF(TRIM(CAST(json_extract(plugin_im.data, '$.category') AS TEXT)), '') = ${properties.directory_name}), 0)"
  }
}
