{
  "$schema": "../../../../src-tauri/core/src/providers/dsl/schema.json5",
  "namespace": "plugins.ziworld",
  "name": "directory_provider",
  "properties": {
    "directory_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "json_valid(plugin_metadata) AND NULLIF(TRIM(CAST(json_extract(plugin_metadata, '$.category') AS TEXT)), '') = ${properties.directory_name}"
  },
  "list": {
    "${page.name}": {
      "child_var": "page",
      "delegate": {
        "provider": "kabegame.page_size_provider",
        "properties": { "page_size": 100 }
      },
      "provider": "kabegame.gallery_page_router",
      "properties": {
        "page_size": 100,
        "page_num": "${page.meta.page_num}"
      },
      "meta": { "page_num": "${page.meta.page_num}" }
    },
  },
  "resolve": {
    "desc": { "provider": "kabegame.sort_router" },
    "x([1-9][0-9]*)x": {
      "provider": "kabegame.gallery_paginate_router",
      "properties": { "page_size": "${capture[1]}" }
    },
    "([1-9][0-9]*)": {
      "provider": "kabegame.gallery_page_router",
      "properties": {
        "page_size": 100,
        "page_num": "${capture[1]}"
      }
    }
  }
}
