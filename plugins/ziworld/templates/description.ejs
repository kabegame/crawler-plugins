<% const m = metadata || {}; %>
<%
  const category = m.category != null ? String(m.category).trim() : '';
  const hasAny = !!category;
%>
<% if (!hasAny) { %>
<p id="zw-desc-empty" class="zw-desc-empty" style="font-size:0.875rem;opacity:0.75;"></p>
<% } else { %>
<style>
.zw-desc-wrap {
  unicode-bidi: isolate;
  font-size: 0.875rem;
  line-height: 1.5;
  color: inherit;
  box-sizing: border-box;
}
.zw-desc-wrap * { box-sizing: border-box; }
.zw-desc-wrap .zw-desc-panel {
  margin: 0;
  padding: 0.65rem 0.75rem;
  border-radius: 8px;
  background: color-mix(in srgb, var(--anime-text-primary, currentColor) 6%, transparent);
  border: 1px solid color-mix(in srgb, var(--anime-text-primary, currentColor) 12%, transparent);
}
.zw-desc-wrap .zw-desc-kv {
  margin: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: baseline;
  gap: 0.35rem 0.75rem;
  padding: 0;
}
.zw-desc-wrap .zw-desc-kv-key {
  flex: 0 0 auto;
  min-width: 6.5rem;
  font-weight: 600;
  color: var(--anime-text-secondary, inherit);
}
.zw-desc-wrap .zw-desc-kv-val {
  flex: 1 1 auto;
  min-width: 0;
  word-break: break-word;
  color: var(--anime-text-primary, inherit);
}
</style>
<div class="zw-desc-wrap" id="zw-desc-root">
  <div class="zw-desc-panel" data-zw-panel="1" aria-label="">
    <div class="zw-desc-kv"><span class="zw-desc-kv-key" data-zw-lbl="directory"></span><span class="zw-desc-kv-val"><%= category %></span></div>
  </div>
</div>
<% } %>
<script>
(function () {
  function zwLabels(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'zhtw') {
      return {
        directory: '目錄',
        panelAria: 'ziworld 詳情元資料',
        empty: '尚無 ziworld 目錄元資料（請以最新版外掛重新抓取）。'
      };
    }
    if (s === 'zh' || (s.indexOf('zh') === 0 && s.indexOf('tw') < 0)) {
      return {
        directory: '目录',
        panelAria: 'ziworld 详情元数据',
        empty: '暂无 ziworld 目录元数据（请使用最新版插件重新抓取）。'
      };
    }
    if (s === 'ja') {
      return {
        directory: 'カテゴリ',
        panelAria: 'ziworld の詳細メタデータ',
        empty: 'ziworld のカテゴリ情報がありません（最新版プラグインで再取得してください）。'
      };
    }
    if (s === 'ko') {
      return {
        directory: '카테고리',
        panelAria: 'ziworld 상세 메타데이터',
        empty: 'ziworld 카테고리 메타데이터가 없습니다(최신 플러그인으로 다시 수집하세요).'
      };
    }
    return {
      directory: 'Category',
      panelAria: 'ziworld detail metadata',
      empty: 'No ziworld directory metadata (re-crawl with the latest plugin).'
    };
  }
  function apply(loc) {
    var L = zwLabels(loc);
    var nodes = document.querySelectorAll('[data-zw-lbl]');
    for (var i = 0; i < nodes.length; i++) {
      var el = nodes[i];
      var k = el.getAttribute('data-zw-lbl');
      if (k && L[k] != null) el.textContent = L[k];
    }
    var panel = document.querySelector('[data-zw-panel="1"]');
    if (panel && L.panelAria) panel.setAttribute('aria-label', L.panelAria);
    var emptyEl = document.getElementById('zw-desc-empty');
    if (emptyEl && L.empty) emptyEl.textContent = L.empty;
  }
  function onReady() {
    if (window.__bridge && window.__bridge.getLocale) {
      window.__bridge.getLocale().then(apply).catch(function () {
        apply('en');
      });
    } else {
      apply((navigator.language || 'en').split('-')[0]);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
  else onReady();
})();
</script>
