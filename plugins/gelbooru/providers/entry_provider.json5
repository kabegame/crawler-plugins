{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.gelbooru",
  "name": "entry_provider",
  "list": {
    "${tag_category.tag_category}": {
      "sql": "SELECT COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.type') AS TEXT)), ''), 'unknown') AS tag_category, COUNT(*) AS image_count FROM (SELECT plugin_metadata FROM (${composed}) AS composed_result GROUP BY plugin_metadata) AS source JOIN json_each(CASE WHEN json_valid(source.plugin_metadata) THEN source.plugin_metadata ELSE '{\"tags\":[]}' END, '$.tags') AS tag GROUP BY tag_category ORDER BY image_count DESC, tag_category ASC",
      "data_var": "tag_category",
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "${tag_category.tag_category}"
      },
    }
  },
  "resolve": {
    "([^/]+)": {
      "provider": "tag_category_provider",
      "properties": {
        "tag_category": "${capture[1]}"
      }
    }
  },
  "note": "{\"title\":\"Gelbooru tags\",\"content\":\"Group Gelbooru images by tag category (artist / copyright / character / general / metadata) from image metadata.\"}"
}
