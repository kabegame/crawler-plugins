  const hasStructured = !!(titleHtml || titlePlain || aName || tags.length || shareUrl || postIp || postTimeStr);
  const hasCommentsList = comments.length > 0;
  const hasAny = hasRichPost || hasRichComments || hasStructured || hasCommentsList;
  const prHtmlRich = hasRichPost
    ? xhhRewriteHeyboxUserMentionAnchors(xhhReplaceHeyboxEmojiSpans(prHtml))
    : prHtml;
  const crHtmlRich = hasRichComments
    ? xhhRewriteHeyboxUserMentionAnchors(xhhReplaceHeyboxEmojiSpans(crHtml))
    : crHtml;
  const titleHtmlRich = titleHtml
    ? xhhRewriteHeyboxUserMentionAnchors(xhhReplaceHeyboxEmojiSpans(titleHtml))
    : "";
  const titlePlainRich = titlePlain ? xhhReplaceHeyboxEmojiBrackets(titlePlain) : "";
  const linkTitleRich = linkTitle ? xhhReplaceHeyboxEmojiBrackets(linkTitle) : "";
  const descText = m.description != null ? String(m.description).trim() : '';
  const descTextRich = descText ? xhhReplaceHeyboxEmojiBrackets(descText) : '';
%>
