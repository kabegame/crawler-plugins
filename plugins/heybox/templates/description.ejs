    <%
      const cIsCy = c.is_cy === true || Number(c.is_cy) === 1;
      const cAvatar = c.avatar != null ? String(c.avatar).trim() : '';
      const cName = c.username != null ? String(c.username) : '';
      const cUid = c.userid != null ? String(c.userid).trim() : '';
      const cProfile = cUid ? `${base}/app/user/profile/${cUid}` : '';
      const cDeco = c.avatar_decoration != null ? String(c.avatar_decoration).trim() : '';
      const cLv = c.level != null ? Number(c.level) : 0;
      const cUp = c.up != null ? Number(c.up) : 0;
      const cTimeStr = xhhFormatUnixTs(c.create_at);
    %>
    <div class="xhh-cmt">
