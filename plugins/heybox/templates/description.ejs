          <div class="xhh-cmt-av-placeholder" aria-hidden="true"></div>
          <% } %>
          <% if (cDeco) { %>
          <img class="xhh-cmt-av-deco" src="<%= esc(cDeco) %>" alt="" referrerpolicy="no-referrer" />
          <% } %>
        </span>
        <% if (cProfile) { %></a><% } %>
      </div>
      <div class="xhh-cmt-line1">
        <% if (cProfile) { %>
        <a class="xhh-cmt-name" href="<%= esc(cProfile) %>" target="_blank" rel="noopener noreferrer"><%= esc(cName) %></a>
        <% } else { %>
        <span class="xhh-cmt-name-plain"><%= esc(cName) %></span>
        <% } %>
        <% if (cLv > 0) { %><span class="xhh-cmt-lv">Lv.<%= esc(String(cLv)) %></span><% } %>
        <% if (c.is_reply) { %><span class="xhh-cmt-meta">· 回复 <% if (c.reply_to_username) { %><%= esc(String(c.reply_to_username)) %><% } %></span><% } %>
        <% if (c.floor_num) { %><span class="xhh-cmt-meta">· #<%= esc(String(c.floor_num)) %></span><% } %>
        <span class="xhh-cmt-up" title="赞"><svg class="xhh-cmt-up-icon" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M832 364.8h-147.2s19.2-64 32-179.2c6.4-57.6-38.4-115.2-102.4-121.6h-12.8c-51.2 0-83.2 32-102.4 76.8l-38.4 96c-32 64-57.6 102.4-76.8 115.2-25.6 12.8-121.6 12.8-128 12.8H128c-38.4 0-64 25.6-64 57.6v480c0 32 25.6 57.6 64 57.6h646.4c96 0 121.6-64 134.4-153.6l51.2-307.2c6.4-70.4-6.4-134.4-128-134.4z m-576 537.6H128V422.4h128v480z m640-409.6l-51.2 307.2c-12.8 57.6-12.8 102.4-76.8 102.4H320V422.4c44.8 0 70.4-6.4 89.6-19.2 32-12.8 64-64 108.8-147.2 25.6-64 38.4-96 44.8-102.4 6.4-19.2 19.2-32 44.8-32h6.4c32 0 44.8 32 44.8 51.2-12.8 102.4-32 166.4-32 166.4l-25.6 83.2h243.2c19.2 0 32 0 44.8 12.8 12.8 12.8 6.4 38.4 6.4 57.6z"></path></svg><%= esc(String(cUp)) %></span>
      </div>
      <div class="xhh-cmt-line2">
        <% if (cTimeStr) { %><span class="xhh-cmt-time"><%= esc(cTimeStr) %></span><% } %>
        <% if (c.ip_location) { %><span class="xhh-cmt-ip"><% if (cTimeStr) { %> · <% } %><%= esc(String(c.ip_location)) %></span><% } %>
      </div>
      <div class="xhh-cmt-body">
        <% if (cIsCy) { %>
        <img class="xhh-cmt-cy" src="<%= esc(xhhCyMarkUrl) %>" alt="" title="插眼" referrerpolicy="no-referrer" />
        <% } %>
        <span class="xhh-cmt-body-text"><%- xhhFormatCommentSnapshotText(c.text != null ? String(c.text) : "") %></span>
      </div>
      <% if (c.imgs && c.imgs.length > 0) { %>
      <div class="xhh-cmt-imgs">
        <% for (const img of c.imgs) { %>
        <% const imgSrc = img.thumb || img.url; %>
        <% if (imgSrc) { %>
        <div class="xhh-cmt-img-wrap">
          <img class="xhh-cmt-img" src="<%= esc(String(imgSrc)) %>" alt="" referrerpolicy="no-referrer" />
        </div>
        <% } %>
        <% } %>
      </div>
      <% } %>
    </div>
    <% } %>
    <% if (comments.length >= commentsMax) { %>
    <p class="xhh-note">仅保留前 <%= commentsMax %> 条，完整列表以当时接口为准。</p>
    <% } %>
  </div>
  <% } %>
</div>
<% } %>
