<div class="xhh-desc-wrap">
  <% if (imgTot > 1) { %>
  <% if (imgIdx > 0) { %>
  <p class="xhh-note">本帖第 <%= imgIdx %> / <%= imgTot %> 张图（元数据为帖子级快照，各图相同）。</p>
  <% } else { %>
  <p class="xhh-note">本帖共 <%= imgTot %> 张图（详情为帖子级共享元数据）。</p>
  <% } %>
  <% } %>

  <% if (hasRichPost && prCss) { %>
  <style><%= prCss %></style>
  <% } %>
  <% if (hasRichPost) { %>
  <div class="xhh-panel xhh-rich-host" data-xhh="post-rich">
    <%- prHtmlRich %>
  </div>
  <% } else { %>
  <div class="xhh-panel" data-xhh="post-structured">
    <% if (aName || aAvatar || (aFan > 0 && isFinite(aFan))) { %>
    <div class="xhh-author-row">
      <div class="xhh-author-av-slot">
        <% if (profileHref) { %><a class="xhh-author-av-link" href="<%= esc(profileHref) %>" target="_blank" rel="noopener noreferrer"><% } %>
        <span class="xhh-author-av-wrap">
          <% if (aAvatar) { %>
          <img class="xhh-author-av" src="<%= esc(aAvatar) %>" alt="" referrerpolicy="no-referrer" />
          <% } else { %>
          <div class="xhh-author-av-placeholder" aria-hidden="true"></div>
          <% } %>
          <% if (aDeco) { %>
          <img class="xhh-author-av-deco" src="<%= esc(aDeco) %>" alt="" referrerpolicy="no-referrer" />
          <% } %>
        </span>
        <% if (profileHref) { %></a><% } %>
      </div>
      <div class="xhh-author-info">
        <div class="xhh-author-line1">
          <% if (aName) { %>
          <% if (profileHref) { %>
          <a class="xhh-author-name" href="<%= esc(profileHref) %>" target="_blank" rel="noopener noreferrer"><%= esc(aName) %></a>
          <% } else { %>
          <span class="xhh-author-name-plain"><%= esc(aName) %></span>
          <% } %>
          <% } %>
          <% if (aLevel > 0) { %><span class="xhh-author-lv">Lv.<%= esc(String(aLevel)) %></span><% } %>
        </div>
        <% if (aFan > 0 && isFinite(aFan)) { %>
        <div class="xhh-author-line2"><span class="xhh-author-fans"><%= esc(String(Math.floor(aFan))) %> 粉丝</span></div>
        <% } %>
      </div>
    </div>
    <% } %>
    <% if (titleHtml) { %>
    <div class="xhh-title-html"><%- titleHtmlRich %></div>
    <% } else if (titlePlain) { %>
    <div class="xhh-title-html"><%- titlePlainRich %></div>
    <% } else if (linkTitle) { %>
    <div class="xhh-title-html"><%- linkTitleRich %></div>
    <% } %>
    <% if (tags.length) { %>
    <div class="xhh-tags">
      <% for (const tg of tags) { %><span class="xhh-tag"><%= esc(tg) %></span><% } %>
    </div>
    <% } %>
    <div class="xhh-meta-line">
      <% if (postTimeStr) { %>发布时间：<%= esc(postTimeStr) %><% } %>
      <% if (postIp) { %><% if (postTimeStr) { %> · <% } %>IP：<%= esc(postIp) %><% } %>
    </div>
    <% if (descTextRich) { %>
    <div class="xhh-meta-line" style="white-space:pre-wrap;"><%- descTextRich %></div>
    <% } %>
    <% if (shareUrl) { %>
    <div class="xhh-meta-line"><a class="xhh-link" href="<%= esc(shareUrl) %>" target="_blank" rel="noopener noreferrer">打开小黑盒分享页</a></div>
    <% } %>
  </div>
  <% } %>

  <% if (hasRichComments && crCss) { %>
  <style><%= crCss %></style>
  <% } %>
  <% if (hasRichComments) { %>
  <div class="xhh-panel xhh-rich-host" data-xhh="comments-rich">
    <div class="xhh-title-html" style="font-size:0.95rem;margin-bottom:0.5rem;">评论（页面快照）</div>
    <%- crHtmlRich %>
  </div>
  <% } else if (hasCommentsList) { %>
  <div class="xhh-panel" data-xhh="comments-list">
