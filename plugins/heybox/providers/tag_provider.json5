{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.heybox",
  "name": "tag_provider",
  "properties": {
    "tag_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{\"tags\":[]}' END, '$.tags') AS tag WHERE TRIM(CAST(tag.value AS TEXT)) = ${properties.tag_name})), 0)"
  }
}
