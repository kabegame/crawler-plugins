{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.konachan",
  "name": "entry_provider",
  "list": {
    "${tag_type.tag_type}": {
      "sql": "SELECT COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.type') AS TEXT)), ''), 'unknown') AS tag_type, COUNT(*) AS image_count FROM (SELECT plugin_metadata FROM (${composed}) AS composed_result GROUP BY plugin_metadata) AS source JOIN json_each(CASE WHEN json_valid(source.plugin_metadata) THEN source.plugin_metadata ELSE '{\"sidebar_tags\":[]}' END, '$.sidebar_tags') AS tag GROUP BY tag_type ORDER BY image_count DESC, tag_type ASC",
      "data_var": "tag_type",
      "provider": "tag_type_provider",
      "properties": {
        "tag_type": "${tag_type.tag_type}"
      },
    }
  },
  "resolve": {
    "([^/]+)": {
      "provider": "tag_type_provider",
      "properties": {
        "tag_type": "${capture[1]}"
      }
    }
  },
  "note": "{\"title\":\"Konachan tags\",\"content\":\"Group Konachan images by sidebar tag type from image metadata.\"}"
}
