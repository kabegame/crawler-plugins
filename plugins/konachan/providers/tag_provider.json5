{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.konachan",
  "name": "tag_provider",
  "properties": {
    "tag_type": { "type": "string", "default": "unknown", "optional": false },
    "tag_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_metadata) THEN plugin_metadata ELSE '{\"sidebar_tags\":[]}' END, '$.sidebar_tags') AS tag WHERE COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.type') AS TEXT)), ''), 'unknown') = ${properties.tag_type} AND COALESCE(NULLIF(TRIM(CAST(json_extract(tag.value, '$.name') AS TEXT)), ''), NULLIF(TRIM(CAST(json_extract(tag.value, '$.display') AS TEXT)), '')) = ${properties.tag_name})"
  },
  "list": {
    "${page.name}": {
      "child_var": "page",
      "delegate": {
        "provider": "kabegame.page_size_provider",
        "properties": { "page_size": 100 }
      },
      "provider": "kabegame.gallery_page_router",
      "properties": {
        "page_size": 100,
        "page_num": "${page.meta.page_num}"
      },
      "meta": { "page_num": "${page.meta.page_num}" }
    },
  },
  "resolve": {
    "desc": { "provider": "kabegame.sort_router" },
    "x([1-9][0-9]*)x": {
      "provider": "kabegame.gallery_paginate_router",
      "properties": { "page_size": "${capture[1]}" }
    },
    "([1-9][0-9]*)": {
      "provider": "kabegame.gallery_page_router",
      "properties": {
        "page_size": 100,
        "page_num": "${capture[1]}"
      }
    }
  }
}
