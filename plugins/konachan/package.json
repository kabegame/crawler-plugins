{
  "name": "konachan",
  "version": "1.2.7",
  "private": true,
  "name.zh": "konachan动漫壁纸",
  "name.en": "Konachan anime wallpapers",
  "name.ja": "konachanアニメ壁紙",
  "name.ko": "konachan 애니메이션 벽지",
  "description": "konachan动漫壁纸收集源插件",
  "description.zh": "konachan动漫壁纸收集源插件",
  "description.en": "Konachan anime wallpaper crawler plugin",
  "description.ja": "konachanアニメ壁紙収集プラグイン",
  "description.ko": "konachan 애니메이션 벽지 수집 플러그인",
  "author": "Kabegame",
  "kbPackageVersion": 3,
  "engines": {
    "kabegame": ">=4.3.0"
  },
  "main": "dist/main.js",
  "kbBackend": "v8",
  "scripts": {
    "build": "rspack build"
  },
  "kbBaseUrl": "https://konachan.net",
  "kbLabels": [
    { "id": "auth.needProxy" },
    { "id": "content.res.desktop" }
  ],
  "kbConfig": [
    {
      "key": "crawl_mode",
      "type": "options",
      "name": "爬取模式",
      "name.en": "Crawl mode",
      "name.ja": "クロールモード",
      "name.ko": "크롤 모드",
      "name.zhtw": "爬取模式",
      "descripts": "爬取模式，分为全部、标签列表和标签",
      "descripts.en": "Crawl mode, divided into all, tag list and tags",
      "descripts.ja": "クロールモード、全部・タグ一覧・タグに分かれています",
      "descripts.ko": "크롤 모드, 전체·태그 목록·태그로 나뉩니다",
      "descripts.zhtw": "爬取模式，分為全部、標籤列表和標籤",
      "default": "all",
      "options": [
        {
          "name": "全部",
          "name.en": "All",
          "name.ja": "全部",
          "name.ko": "전체",
          "name.zhtw": "全部",
          "variable": "all"
        },
        {
          "name": "标签列表",
          "name.en": "Tag list",
          "name.ja": "タグ一覧",
          "name.ko": "태그 목록",
          "name.zhtw": "標籤列表",
          "variable": "tag_list"
        },
        {
          "name": "标签",
          "name.en": "Tags",
          "name.ja": "タグ",
          "name.ko": "태그",
          "name.zhtw": "標籤",
          "variable": "tags"
        }
      ]
    },
    {
      "key": "start_page",
      "type": "int",
      "name": "起始页面",
      "name.en": "Start page",
      "name.ja": "開始ページ",
      "name.ko": "시작 페이지",
      "name.zhtw": "起始頁面",
      "descripts": "要拉取的起始页面",
      "descripts.en": "Start page to crawl from",
      "descripts.ja": "取得開始ページ",
      "descripts.ko": "가져올 시작 페이지",
      "descripts.zhtw": "要拉取的起始頁面",
      "default": 1,
      "options": null,
      "min": 1,
      "max": null,
      "when": {
        "crawl_mode": [
          "all",
          "tags"
        ]
      }
    },
    {
      "key": "end_page",
      "type": "int",
      "name": "结束页数",
      "name.en": "End page",
      "name.ja": "終了ページ",
      "name.ko": "끝 페이지",
      "name.zhtw": "結束頁數",
      "descripts": "要拉取的结束页面。请保持最多爬取100页，降低并发量文明爬取。否则拒绝爬取",
      "descripts.en": "End page. Keep at most 100 pages per run.",
      "descripts.ja": "終了ページ。1回あたり100ページ以内にしてください。",
      "descripts.ko": "끝 페이지. 실행당 최대 100페이지로 제한됩니다.",
      "descripts.zhtw": "要拉取的結束頁面。請保持最多爬取100頁，降低並發量文明爬取。否則拒絕爬取",
      "default": 5,
      "options": null,
      "min": 1,
      "max": null,
      "when": {
        "crawl_mode": [
          "all",
          "tags"
        ]
      }
    },
    {
      "key": "tag",
      "type": "string",
      "name": "标签",
      "name.en": "Tag",
      "name.ja": "タグ",
      "name.ko": "태그",
      "name.zhtw": "標籤",
      "descripts": "要爬取的标签，可用*作为通配符（默认：genshin_impact）",
      "descripts.en": "Tag to crawl, use * as wildcard (default: genshin_impact)",
      "descripts.ja": "クロールするタグ、*を使用してワイルドカード（デフォルト：原神）",
      "descripts.ko": "크롤할 태그、*를 사용하여 와일드카드（기본값：원신）",
      "descripts.zhtw": "要爬取的標籤，可用*作為通配符（預設：原神）",
      "default": "genshin_impact",
      "when": {
        "crawl_mode": [
          "tag_list"
        ]
      }
    },
    {
      "key": "mode_tag_type",
      "type": "options",
      "name": "标签类型",
      "name.en": "Tag type",
      "name.ja": "タグタイプ",
      "name.ko": "태그 타입",
      "name.zhtw": "標籤類型",
      "descripts": "标签类型，分为任意(Any)、通用(General)、作家(Artist)、版权(Copyright)、角色(Character)、风格(Style)、圈子(Circle)",
      "descripts.en": "Tag type, divided into Any, General, Artist, Copyright, Character, Style, Circle",
      "descripts.ja": "タグタイプ、任意(Any)、ジェネラル(General)、作家(Artist)、著作権(Copyright)、キャラクター(Character)、スタイル(Style)、界隈(Circle)に分かれています",
      "descripts.ko": "태그 타입, 任意(Any)、중복(General)、작가(Artist)、저작권(Copyright)、캐릭터(Character)、스타일(Style)、원(Circle)에 나뉩니다",
      "descripts.zhtw": "標籤類型，分為任意(Any)、通用(General)、作家(Artist)、版權(Copyright)、角色(Character)、風格(Style)、圈子(Circle)",
      "default": "",
      "options": [
        {
          "name": "任意(Any)",
          "name.en": "Any",
          "name.ja": "任意",
          "name.ko": "任意",
          "name.zhtw": "任意",
          "variable": ""
        },
        {
          "name": "通用(General)",
          "name.en": "General",
          "name.ja": "通用",
          "name.ko": "通用",
          "name.zhtw": "通用",
          "variable": "general"
        },
        {
          "name": "作家(Artist)",
          "name.en": "Artist",
          "name.ja": "作家",
          "name.ko": "作家",
          "name.zhtw": "作家",
          "variable": "artist"
        },
        {
          "name": "版权(Copyright)",
          "name.en": "Copyright",
          "name.ja": "著作権",
          "name.ko": "저작권",
          "name.zhtw": "版權",
          "variable": "copyright"
        },
        {
          "name": "角色(Character)",
          "name.en": "Character",
          "name.ja": "キャラクター",
          "name.ko": "캐릭터",
          "name.zhtw": "角色",
          "variable": "character"
        },
        {
          "name": "风格(Style)",
          "name.en": "Style",
          "name.ja": "スタイル",
          "name.ko": "스타일",
          "name.zhtw": "風格",
          "variable": "style"
        },
        {
          "name": "圈子(Circle)",
          "name.en": "Circle",
          "name.ja": "界隈",
          "name.ko": "원",
          "name.zhtw": "圈子",
          "variable": "circle"
        }
      ],
      "when": {
        "crawl_mode": [
          "tag_list"
        ]
      }
    },
    {
      "key": "mode_tag_order",
      "type": "options",
      "name": "标签排序",
      "name.en": "Tag order",
      "name.ja": "タグ順序",
      "name.ko": "태그 순서",
      "name.zhtw": "標籤排序",
      "descripts": "标签排序，分为名称(Name)、图片数量(Count)、日期(Date)",
      "descripts.en": "Tag order, divided into Name, Count, Date",
      "descripts.ja": "タグ順序、名称(Name)、画像数(Count)、日付(Date)に分かれています",
      "descripts.ko": "태그 순서, 이름(Name)、이미지 수(Count)、날짜(Date)에 나뉩니다",
      "descripts.zhtw": "標籤排序，分為名稱(Name)、圖片數量(Count)、日期(Date)",
      "default": "name",
      "options": [
        {
          "name": "名称(Name)",
          "name.en": "Name",
          "name.ja": "名称",
          "name.ko": "이름",
          "name.zhtw": "名稱",
          "variable": "name"
        },
        {
          "name": "图片数量(Count)",
          "name.en": "Count",
          "name.ja": "画像数",
          "name.ko": "이미지 수",
          "name.zhtw": "圖片數量",
          "variable": "count"
        },
        {
          "name": "日期(Date)",
          "name.en": "Date",
          "name.ja": "日付",
          "name.ko": "날짜",
          "name.zhtw": "日期",
          "variable": "date"
        }
      ],
      "when": {
        "crawl_mode": [
          "tag_list"
        ]
      }
    },
    {
      "key": "mode_tag_skip",
      "type": "int",
      "name": "跳过标签数量",
      "name.en": "Skip tag count",
      "name.ja": "タグスキップ数",
      "name.ko": "태그 스킵 수",
      "name.zhtw": "跳過標籤數量",
      "descripts": "跳过标签数量，默认跳过10个标签",
      "descripts.en": "Skip tag count, default skip 10 tags",
      "descripts.ja": "タグスキップ数、デフォルトで10個のタグをスキップします",
      "descripts.ko": "태그 스킵 수, 기본적으로 10개의 태그를 스킵합니다",
      "descripts.zhtw": "跳過標籤數量，預設跳過10個標籤",
      "default": 10,
      "options": null,
      "min": 0,
      "max": null,
      "when": {
        "crawl_mode": [
          "tag_list"
        ]
      }
    },
    {
      "key": "mode_tag_value",
      "type": "list",
      "name": "标签组合",
      "name.en": "Tag combination",
      "name.ja": "タグ組み合わせ",
      "name.ko": "태그 조합",
      "name.zhtw": "標籤組合",
      "descripts": "输入多个标签（列表），运行时会用+连接；标签中的空格会自动转为下划线_",
      "descripts.en": "Input multiple tags as a list; runtime joins them with + and converts spaces to _",
      "descripts.ja": "複数タグをリストで入力。実行時に + で連結し、空白は _ に変換します",
      "descripts.ko": "여러 태그를 목록으로 입력합니다. 실행 시 + 로 결합하며 공백은 _ 로 변환됩니다",
      "descripts.zhtw": "輸入多個標籤（列表），執行時會用 + 連接，標籤中的空格會自動轉為下劃線_",
      "default": [
        "pink_hair",
        "bikini"
      ],
      "options": null,
      "when": {
        "crawl_mode": [
          "tags"
        ]
      }
    },
    {
      "key": "quality",
      "type": "options",
      "name": "质量",
      "name.en": "Quality",
      "name.ja": "画質",
      "name.ko": "화질",
      "name.zhtw": "畫質",
      "descripts": "图片质量，这个网站质量都挺高的",
      "descripts.en": "Image quality",
      "descripts.ja": "画像の画質",
      "descripts.ko": "이미지 화질",
      "descripts.zhtw": "圖片畫質，此站畫質都挺高",
      "default": "medium",
      "options": [
        {
          "name": "高",
          "name.en": "High",
          "name.ja": "高",
          "name.ko": "고화질",
          "name.zhtw": "高",
          "variable": "high"
        },
        {
          "name": "中",
          "name.en": "Medium",
          "name.ja": "中",
          "name.ko": "중간",
          "name.zhtw": "中",
          "variable": "medium"
        }
      ]
    }
  ],
  "kbIcon": "icon.png",
  "kbDoc": {
    "en": "doc_root/doc.en.md",
    "ja": "doc_root/doc.ja.md",
    "ko": "doc_root/doc.ko.md",
    "default": "doc_root/doc.md",
    "zh": "doc_root/doc.zh.md",
    "zhtw": "doc_root/doc.zhtw.md"
  },
  "kbRecommendedConfigs": [
    "configs/bikini.json",
    "configs/every-day-5page.json",
    "configs/genshin_impact.json"
  ],
  "kbPathQLProviders": [
    "providers/entry_provider.json5",
    "providers/tag_provider.json5",
    "providers/tag_type_provider.json5"
  ],
  "kbDescriptionTemplate": "templates/description.ejs"
}
