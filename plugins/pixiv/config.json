{
  "$schema": "../../config.schema.json",
  "baseUrl": "https://www.pixiv.net",
  "var": [
    {
      "key": "source",
      "type": "options",
      "name": "爬取类型",
      "name.en": "Source type",
      "name.ja": "取得タイプ",
      "name.ko": "수집 유형",
      "name.zhtw": "爬取類型",
      "default": "ranking",
      "options": [
        {
          "name": "排行榜",
          "name.en": "Ranking",
          "name.ja": "ランキング",
          "name.ko": "랭킹",
          "name.zhtw": "排行榜",
          "variable": "ranking"
        },
        {
          "name": "个人收藏",
          "name.en": "Bookmarks",
          "name.ja": "ブックマーク",
          "name.ko": "북마크",
          "name.zhtw": "個人收藏",
          "variable": "bookmark"
        },
        {
          "name": "画师作品",
          "name.en": "Artist works",
          "name.ja": "作家作品",
          "name.ko": "작가 작품",
          "name.zhtw": "畫師作品",
          "variable": "user"
        },
        {
          "name": "关键词搜索",
          "name.en": "Keyword search",
          "name.ja": "キーワード検索",
          "name.ko": "키워드 검색",
          "name.zhtw": "關鍵字搜尋",
          "variable": "keyword"
        }
      ]
    },
    {
      "key": "user_id",
      "type": "string",
      "name": "用户 UID",
      "name.en": "User UID",
      "name.ja": "ユーザー UID",
      "name.ko": "사용자 UID",
      "name.zhtw": "用戶 UID",
      "descripts": "收藏：被爬取用户 UID（仅用于 URL，与 PixivCrawler 一致不发送 x-user-id）。画师：登录账号 UID，对应 PixivCrawler 的 x-user-id，必填。",
      "descripts.en": "Bookmarks: target user UID (URL only; no x-user-id, same as PixivCrawler). Artist: your account UID for x-user-id (required, like PixivCrawler user_config.user_id).",
      "descripts.ja": "ブックマーク：対象ユーザー UID（URL のみ、PixivCrawler と同様 x-user-id なし）。作家：ログイン UID（x-user-id 用、必須）。",
      "descripts.ko": "북마크: 대상 UID(URL만, PixivCrawler처럼 x-user-id 없음). 작가: 로그인 UID(x-user-id, 필수).",
      "descripts.zhtw": "收藏：被爬取用戶 UID（僅 URL，與 PixivCrawler 一致不送 x-user-id）。畫師：登入帳號 UID（x-user-id，必填）。",
      "when": { "source": ["bookmark", "user"] }
    },
    {
      "key": "ranking_mode",
      "type": "options",
      "name": "排行榜类型",
      "name.en": "Ranking mode",
      "name.ja": "ランキング種別",
      "name.ko": "랭킹 유형",
      "name.zhtw": "排行榜類型",
      "default": "daily",
      "options": [
        {
          "name": "日榜",
          "name.en": "Daily",
          "name.ja": "日間",
          "name.ko": "일간",
          "name.zhtw": "日榜",
          "variable": "daily"
        },
        {
          "name": "周榜",
          "name.en": "Weekly",
          "name.ja": "週間",
          "name.ko": "주간",
          "name.zhtw": "週榜",
          "variable": "weekly"
        },
        {
          "name": "月榜",
          "name.en": "Monthly",
          "name.ja": "月間",
          "name.ko": "월간",
          "name.zhtw": "月榜",
          "variable": "monthly"
        },
        {
          "name": "男性向",
          "name.en": "Male",
          "name.ja": "男性向け",
          "name.ko": "남성향",
          "name.zhtw": "男性向",
          "variable": "male"
        },
        {
          "name": "女性向",
          "name.en": "Female",
          "name.ja": "女性向け",
          "name.ko": "여성향",
          "name.zhtw": "女性向",
          "variable": "female"
        },
        {
          "name": "AI 日榜",
          "name.en": "AI Daily",
          "name.ja": "AI 日間",
          "name.ko": "AI 일간",
          "name.zhtw": "AI 日榜",
          "variable": "daily_ai"
        },
        {
          "name": "日榜 R18",
          "name.en": "Daily R18",
          "name.ja": "日間 R18",
          "name.ko": "일간 R18",
          "name.zhtw": "日榜 R18",
          "variable": "daily_r18"
        },
        {
          "name": "周榜 R18",
          "name.en": "Weekly R18",
          "name.ja": "週間 R18",
          "name.ko": "주간 R18",
          "name.zhtw": "週榜 R18",
          "variable": "weekly_r18"
        },
        {
          "name": "男性向 R18",
          "name.en": "Male R18",
          "name.ja": "男性向け R18",
          "name.ko": "남성향 R18",
          "name.zhtw": "男性向 R18",
          "variable": "male_r18"
        },
        {
          "name": "女性向 R18",
          "name.en": "Female R18",
          "name.ja": "女性向け R18",
          "name.ko": "여성향 R18",
          "name.zhtw": "女性向 R18",
          "variable": "female_r18"
        },
        {
          "name": "AI 日榜 R18",
          "name.en": "AI Daily R18",
          "name.ja": "AI 日間 R18",
          "name.ko": "AI 일간 R18",
          "name.zhtw": "AI 日榜 R18",
          "variable": "daily_r18_ai"
        }
      ],
      "when": { "source": ["ranking"] }
    },
    {
      "key": "content_mode",
      "type": "options",
      "name": "内容类型",
      "name.en": "Content type",
      "name.ja": "コンテンツタイプ",
      "name.ko": "콘텐츠 유형",
      "name.zhtw": "內容類型",
      "default": "all",
      "options": [
        {
          "name": "全部",
          "name.en": "All",
          "name.ja": "すべて",
          "name.ko": "전체",
          "name.zhtw": "全部",
          "variable": "all"
        },
        {
          "name": "插画",
          "name.en": "Illust",
          "name.ja": "イラスト",
          "name.ko": "일러스트",
          "name.zhtw": "插畫",
          "variable": "illust"
        },
        {
          "name": "漫画",
          "name.en": "Manga",
          "name.ja": "漫画",
          "name.ko": "만화",
          "name.zhtw": "漫畫",
          "variable": "manga"
        },
        {
          "name": "动图",
          "name.en": "Ugoira",
          "name.ja": "うごイラ",
          "name.ko": "움직이는 일러스트",
          "name.zhtw": "動圖",
          "variable": "ugoira"
        }
      ],
      "when": {
        "source": ["ranking"],
        "ranking_mode": ["daily", "weekly", "monthly", "daily_ai"]
      }
    },
    {
      "key": "start_date",
      "type": "date",
      "format": "YYYYMMDD",
      "dateMin": "2007-01-01",
      "dateMax": "yesterday",
      "name": "起始日期",
      "name.en": "Start date",
      "name.ja": "開始日",
      "name.ko": "시작일",
      "name.zhtw": "起始日期",
      "descripts": "排行榜统计起始日（含当日），须不晚于结束日期",
      "descripts.en": "First ranking calendar day (inclusive); must not be after end date",
      "descripts.ja": "ランキング取得の開始日（当日含む）。終了日以降にできません",
      "descripts.ko": "랭킹 시작일(당일 포함). 종료일보다 늦을 수 없음",
      "descripts.zhtw": "排行榜統計起始日（含當日），須不晚於結束日期",
      "default": "",
      "when": { "source": ["ranking"] }
    },
    {
      "key": "end_date",
      "type": "date",
      "format": "YYYYMMDD",
      "dateMin": "2007-01-01",
      "dateMax": "yesterday",
      "name": "结束日期",
      "name.en": "End date",
      "name.ja": "終了日",
      "name.ko": "종료일",
      "name.zhtw": "結束日期",
      "descripts": "排行榜统计结束日（含当日），须不早于起始日期",
      "descripts.en": "Last ranking calendar day (inclusive); must not be before start date",
      "descripts.ja": "ランキング取得の終了日（当日含む）。開始日より前にできません",
      "descripts.ko": "랭킹 종료일(당일 포함). 시작일보다 이전일 수 없음",
      "descripts.zhtw": "排行榜統計結束日（含當日），須不早於起始日期",
      "default": "",
      "when": { "source": ["ranking"] }
    },
    {
      "key": "artist_id",
      "type": "string",
      "name": "画师 UID",
      "name.en": "Artist UID",
      "name.ja": "作家 UID",
      "name.ko": "작가 UID",
      "name.zhtw": "畫師 UID",
      "descripts": "要爬取的画师的 Pixiv UID",
      "descripts.en": "Pixiv artist UID to crawl",
      "descripts.ja": "取得する作家の Pixiv UID",
      "descripts.ko": "수집할 작가의 Pixiv UID",
      "descripts.zhtw": "要爬取的畫師 Pixiv UID",
      "when": { "source": ["user"] }
    },
    {
      "key": "keyword",
      "type": "string",
      "name": "搜索关键词",
      "name.en": "Search keyword",
      "name.ja": "検索キーワード",
      "name.ko": "검색 키워드",
      "name.zhtw": "搜尋關鍵字",
      "descripts": "支持高级搜索语法，如 (Lucy OR 边缘行者) AND 5000users",
      "descripts.en": "Supports advanced syntax, e.g. (Lucy OR 边缘行者) AND 5000users",
      "descripts.ja": "高度な検索構文対応（例：(Lucy OR 边缘行者) AND 5000users）",
      "descripts.ko": "고급 검색 문법 지원 (예: (Lucy OR 边缘行者) AND 5000users)",
      "descripts.zhtw": "支援進階搜尋語法，如 (Lucy OR 邊緣行者) AND 5000users",
      "when": { "source": ["keyword"] }
    },
    {
      "key": "search_mode",
      "type": "options",
      "name": "搜索模式",
      "name.en": "Search mode",
      "name.ja": "検索モード",
      "name.ko": "검색 모드",
      "name.zhtw": "搜尋模式",
      "default": "safe",
      "options": [
        {
          "name": "安全",
          "name.en": "Safe",
          "name.ja": "全年齢",
          "name.ko": "안전",
          "name.zhtw": "安全",
          "variable": "safe"
        },
        {
          "name": "R18",
          "name.en": "R18",
          "name.ja": "R18",
          "name.ko": "R18",
          "name.zhtw": "R18",
          "variable": "r18"
        },
        {
          "name": "全部",
          "name.en": "All",
          "name.ja": "すべて",
          "name.ko": "전체",
          "name.zhtw": "全部",
          "variable": "all"
        }
      ],
      "when": { "source": ["keyword"] }
    },
    {
      "key": "keyword_order",
      "type": "options",
      "name": "排序方式",
      "name.en": "Sort order",
      "name.ja": "並び順",
      "name.ko": "정렬 순서",
      "name.zhtw": "排序方式",
      "default": "date",
      "descripts": "按人气排序需要 Pixiv Premium 账户",
      "descripts.en": "Popular sort requires Pixiv Premium",
      "descripts.ja": "人気順は Pixiv Premium が必要です",
      "descripts.ko": "인기순 정렬은 Pixiv Premium이 필요합니다",
      "descripts.zhtw": "依人氣排序需 Pixiv Premium 帳戶",
      "options": [
        {
          "name": "按日期",
          "name.en": "By date",
          "name.ja": "日付順",
          "name.ko": "날짜순",
          "name.zhtw": "按日期",
          "variable": "date"
        },
        {
          "name": "按人气",
          "name.en": "By popularity",
          "name.ja": "人気順",
          "name.ko": "인기순",
          "name.zhtw": "按人氣",
          "variable": "popular"
        }
      ],
      "when": { "source": ["keyword"] }
    },
    {
      "key": "num_artworks",
      "type": "int",
      "name": "最大作品数",
      "name.en": "Max artworks",
      "name.ja": "最大作品数",
      "name.ko": "최대 작품 수",
      "name.zhtw": "最大作品數",
      "descripts": "按「作品」计数（非单张图片）。脚本流式拉列表并边下边停；漫画/多页作品仍会下多张图，落盘文件数可能大于本值。细则见文档。",
      "descripts.en": "Counts artworks (illustrations), not individual image files. Script streams the list and downloads as it goes. Multi-page works still yield multiple files. See docs.",
      "descripts.ja": "「作品」単位の上限（枚数ではない）。リストを逐次取得しながらダウンロード。漫画など複数ページは複数ファイルになり得ます。詳細は説明へ。",
      "descripts.ko": "「작품」 개수 기준(이미지 장수 아님). 목록을 순차로 받으며 받는 대로 다운로드. 만화 등 다페이지는 파일 수가 더 많을 수 있음. 자세한 내용은 문서 참고.",
      "descripts.zhtw": "以「作品」計數（非單張圖）。腳本邊拉列表邊下載；漫畫多頁仍可能多檔，落盤檔數可能大於本值。詳見說明。",
      "default": 50,
      "min": 1,
      "max": 1000
    }
  ]
}
