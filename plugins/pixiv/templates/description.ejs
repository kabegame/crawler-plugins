.px-stat svg{flex-shrink:0;display:block;color:var(--anime-text-secondary,#858585);}
.px-author-bar{display:flex;align-items:center;gap:10px;margin:0 0 10px;min-width:0;}
.px-author-bar[hidden]{display:none !important;}
.px-author-bar .px-open{display:inline-flex;align-items:center;gap:10px;min-width:0;max-width:100%;text-decoration:none;color:inherit;cursor:pointer;}
.px-author-bar .px-open:hover .px-author-name{text-decoration:underline;}
.px-author-avatar{flex-shrink:0;width:40px;height:40px;border-radius:50%;object-fit:cover;background:color-mix(in srgb,var(--anime-text-secondary,#9ca3af) 14%,transparent);display:block;}
.px-author-name{font-size:0.875rem;font-weight:600;line-height:1.35;color:var(--anime-text-primary,#1f2937);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.px-title-link{display:block;margin:0 0 8px;font-size:1rem;font-weight:600;line-height:1.35;color:var(--anime-text-primary,#1f2937);text-decoration:none;cursor:pointer;}
.px-title-link:hover{opacity:0.88;text-decoration:underline;}
#px-comments-container{display:flex;flex-direction:column;gap:0;}
.px-comment-row{display:flex;align-items:flex-start;gap:12px;margin:0;padding:12px 0;border-bottom:1px solid color-mix(in srgb,var(--anime-border,#e5e7eb) 50%,transparent);}
.px-comment-row:last-child{border-bottom:none;}
.px-comment-avatar{flex-shrink:0;width:40px;height:40px;border-radius:50%;overflow:hidden;background:color-mix(in srgb,var(--anime-text-secondary,#9ca3af) 12%,transparent);}
.px-comment-avatar img{display:block;width:100%;height:100%;object-fit:cover;}
.px-comment-main{flex:1;min-width:0;display:flex;flex-direction:column;gap:6px;}
.px-comment-name{font-size:0.8125rem;font-weight:600;line-height:1.35;color:var(--anime-text-primary,#1f2937);}
.px-comment-body{font-size:0.875rem;color:var(--anime-text-primary,#1f2937);word-break:break-word;line-height:1.5;}
.px-comment-body img.px-comment-emoji{vertical-align:middle;object-fit:contain;}
.px-comment-body--solo img.px-comment-emoji{width:80px;height:80px;}
.px-comment-meta{font-size:0.75rem;line-height:1.35;color:var(--anime-text-secondary,#6b7280);font-variant-numeric:tabular-nums;}
</style>
