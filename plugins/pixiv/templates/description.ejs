    <% for (let pci = 0; pci < pxComments.length; pci++) { const pcm = pxComments[pci]; const pcUid = pcm.userId != null ? String(pcm.userId) : ''; const pcUname = pcm.userName != null ? String(pcm.userName) : ''; const pcImg = pcm.img != null ? String(pcm.img) : ''; const pcDate = pcm.commentDate != null ? pxFmtDate(String(pcm.commentDate)) : ''; %>
    <div class="px-comment-row" role="listitem">
      <div class="px-comment-avatar">
        <% if (pcImg) { %><img src="<%= pcImg %>" alt="" referrerpolicy="no-referrer" /><% } %>
      </div>
      <div class="px-comment-main">
        <div class="px-comment-name">
          <% if (pcUid) { %><a href="#" class="px-open" data-url="https://www.pixiv.net/users/<%= encodeURIComponent(pcUid) %>" style="color:inherit;text-decoration:none;cursor:pointer;"><%= pcUname || pcUid %></a><% } else { %><%= pcUname || '?' %><% } %>
        </div>
        <%- pxCommentBodyHtml(pcm.comment, pcm.stampId) %>
        <div class="px-comment-meta"><%= pcDate %></div>
      </div>
    </div>
    <% } %>
    <% if (!pxComments.length) { %><p style="font-size:0.8rem;color:var(--anime-text-secondary,#9ca3af);margin:4px 0;">No comments</p><% } %>
  </div>
  <% } else { %>
  <p style="font-size:0.8rem;color:var(--anime-text-secondary,#6b7280);margin:0;">Re-crawl with illust metadata to load comments.</p>
  <% } %>
</div>
<script>
(function () {
  var ILLUST_ID = <%- JSON.stringify(illustId) %>;
  var PX_SEEDED_AUTHOR_ID = <%- JSON.stringify(pxAuthorId || '') %>;
  var PXIMG_PLACEHOLDER = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
  var PXIMG_PROXY_HEADERS = {
    Referer: 'https://www.pixiv.net/',
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'
  };

  function pxCssVar(name, fallback) {
    var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  function pixivLang(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'ja') return 'ja';
    if (s.indexOf('zh') === 0) return 'zh';
    if (s === 'ko') return 'ko';
    return 'en';
  }

  /** 作品说明折叠：与 Pixiv 作品页 expandable 段落类似（约 180px 高 + 続きを読む）；无溢出时不显示按钮 */
  var CAPTION_CLIP_MAX_PX = 180;
  /** 子像素/行高误差，避免「刚好贴边」仍出现按钮 */
  var CAPTION_OVERFLOW_EPS_PX = 2;

  var pxCaptionExpand = { ro: null, loc: 'en', expanded: false, btnBound: false };

  function captionReadMoreLabel(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'ja') return '続きを読む';
    if (s === 'zhtw') return '顯示更多';
    if (s.indexOf('zh') === 0) return '查看更多';
    if (s === 'ko') return '더 보기';
    return 'Read more';
  }

  function captionShowLessLabel(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'ja') return '折りたたむ';
    if (s === 'zhtw') return '收合';
    if (s.indexOf('zh') === 0) return '收起';
    if (s === 'ko') return '접기';
    return 'Show less';
  }

  function pxCaptionExpandEls() {
    return {
      clip: document.getElementById('px-illust-desc-clip'),
      foot: document.getElementById('px-illust-desc-foot'),
      btn: document.getElementById('px-illust-desc-toggle'),
      inner: document.getElementById('px-illust-desc')
    };
  }

  /** clip 折叠不影响 inner.scrollHeight，可直接与上限比较 */
  function pxCaptionContentOverflows(inner) {
    if (!inner) return false;
    return inner.scrollHeight > CAPTION_CLIP_MAX_PX + CAPTION_OVERFLOW_EPS_PX;
  }

  function applyPxCaptionExpandLayout() {
    var els = pxCaptionExpandEls();
    var clip = els.clip;
    var foot = els.foot;
    var btn = els.btn;
    var inner = els.inner;
    if (!clip || !foot || !btn || !inner) return;

    var loc = pxCaptionExpand.loc || 'en';
    var overflows = pxCaptionContentOverflows(inner);

    if (!overflows) {
      pxCaptionExpand.expanded = false;
      foot.hidden = true;
      clip.classList.remove('is-collapsed');
      btn.textContent = '';
      btn.setAttribute('aria-expanded', 'true');
      return;
    }

    foot.hidden = false;
    if (pxCaptionExpand.expanded) {
      clip.classList.remove('is-collapsed');
      btn.textContent = captionShowLessLabel(loc);
      btn.setAttribute('aria-expanded', 'true');
    } else {
      clip.classList.add('is-collapsed');
      btn.textContent = captionReadMoreLabel(loc);
      btn.setAttribute('aria-expanded', 'false');
    }
  }

  function onPxCaptionExpandBtnClick() {
    var els = pxCaptionExpandEls();
    if (!els.inner || !els.foot || els.foot.hidden) return;
    if (!pxCaptionContentOverflows(els.inner)) {
      applyPxCaptionExpandLayout();
      return;
    }
    pxCaptionExpand.expanded = !pxCaptionExpand.expanded;
    applyPxCaptionExpandLayout();
  }

  function initPxCaptionExpand(loc) {
    pxCaptionExpand.loc = loc || 'en';
    var els = pxCaptionExpandEls();
    if (!els.clip || !els.foot || !els.btn || !els.inner) return;

    if (!pxCaptionExpand.btnBound) {
      pxCaptionExpand.btnBound = true;
      els.btn.addEventListener('click', onPxCaptionExpandBtnClick);
    }

    if (pxCaptionExpand.ro) {
      try {
        pxCaptionExpand.ro.disconnect();
      } catch (e) {}
      pxCaptionExpand.ro = null;
    }

    pxCaptionExpand.expanded = false;
    applyPxCaptionExpandLayout();
    requestAnimationFrame(applyPxCaptionExpandLayout);

    if (typeof ResizeObserver !== 'undefined') {
      pxCaptionExpand.ro = new ResizeObserver(function () {
        if (!pxCaptionContentOverflows(els.inner)) {
          pxCaptionExpand.expanded = false;
        }
        applyPxCaptionExpandLayout();
      });
      pxCaptionExpand.ro.observe(els.inner);
    }
  }

  function setPxHidden(el, hidden) {
    if (!el) return;
    if (hidden) el.setAttribute('hidden', '');
    else el.removeAttribute('hidden');
  }

  /**
   * Pixiv ajax/illust 与评论等接口的 lang 需与作品页一致：用宿主 getLocale() 得到 loc，再经 pixivLang(loc) → ja|zh|ko|en。
   */
  function fetchIllustBody(pixivLangCode) {
    var lang = pixivLangCode != null && pixivLangCode !== '' ? String(pixivLangCode) : 'en';
    var url = 'https://www.pixiv.net/ajax/illust/' + encodeURIComponent(ILLUST_ID) + '?lang=' + encodeURIComponent(lang);
    var h = {
      'Accept': 'application/json',
      'Referer': 'https://www.pixiv.net/artworks/' + ILLUST_ID,
      'Origin': 'https://www.pixiv.net',
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'
    };
    return window.__bridge.fetch(url, { headers: h, json: true });
  }

  /** tags.authorId 优先，否则 userId；与 /ajax/user 一致 */
  function extractAuthorIdFromIllustBody(body) {
    if (!body || typeof body !== 'object') return '';
    if (body.tags && body.tags.authorId != null && String(body.tags.authorId).trim() !== '') return String(body.tags.authorId);
    if (body.userId != null && String(body.userId).trim() !== '') return String(body.userId);
    return '';
  }

  var pxLastAuthorAjaxSuccessId = '';

  /** GET /ajax/user/{id}?full=0&lang=… 取昵称与 image；头像走 __bridge 拉 i.pximg */
  function hydrateAuthorAjax(body, appLoc) {
    if (!window.__bridge || !window.__bridge.fetch) return;
    var bar = document.getElementById('px-author-bar');
    if (!bar) return;
    var aid = extractAuthorIdFromIllustBody(body);
    if (!aid) aid = String(PX_SEEDED_AUTHOR_ID || '');
    if (!aid) return;
    if (pxLastAuthorAjaxSuccessId === aid) return;

    var lang = pixivLang(appLoc || 'en');
    var url = 'https://www.pixiv.net/ajax/user/' + encodeURIComponent(aid) + '?full=0&lang=' + encodeURIComponent(lang);
    var ref = ILLUST_ID
      ? ('https://www.pixiv.net/artworks/' + encodeURIComponent(ILLUST_ID) + '?lang=' + encodeURIComponent(lang))
      : 'https://www.pixiv.net/';
    var h = {
      'Accept': 'application/json',
      'Referer': ref,
      'Origin': 'https://www.pixiv.net',
      'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/145.0.0.0 Safari/537.36'
    };
    window.__bridge.fetch(url, { headers: h, json: true }).then(function (json) {
      if (!json || json.error) return;
      var u = json.body != null && typeof json.body === 'object' ? json.body : json;
      if (!u || typeof u !== 'object') return;
      pxLastAuthorAjaxSuccessId = aid;

      var link = document.getElementById('px-author-link');
      var nameEl = document.getElementById('px-author-name');
      var img = document.getElementById('px-author-avatar');
      var uid = u.userId != null ? String(u.userId) : aid;
      if (nameEl && u.name != null) nameEl.textContent = String(u.name);
      if (link && uid) link.setAttribute('data-url', 'https://www.pixiv.net/users/' + encodeURIComponent(uid));
      if (!img) return;
      var disp = u.name != null ? String(u.name) : (nameEl ? nameEl.textContent : '');
      img.alt = disp || '';
      var iu = u.image != null ? String(u.image) : '';
      if (!iu) {
        img.src = PXIMG_PLACEHOLDER;
        img.removeAttribute('data-px-profile-src');
        return;
      }
      if (iu.indexOf('i.pximg.net/user-profile') >= 0) {
        img.src = PXIMG_PLACEHOLDER;
        img.setAttribute('data-px-profile-src', iu);
      } else {
        img.removeAttribute('data-px-profile-src');
        img.src = iu;
      }
      hydratePxProfileImages(bar);
    }).catch(function () {});
  }

  function localeTagForIntl(loc) {
    var s = String(loc || 'en').toLowerCase();
    if (s === 'zhtw') return 'zh-TW';
    if (s.indexOf('zh') === 0) return 'zh-CN';
    if (s === 'ja') return 'ja-JP';
    if (s === 'ko') return 'ko-KR';
    return 'en-US';
  }

  function formatPxIllustDate(iso, loc) {
    if (!iso) return '';
    var d = new Date(iso);
    if (isNaN(d.getTime())) return String(iso);
    var tag = localeTagForIntl(loc);
    try {
      return new Intl.DateTimeFormat(tag, { dateStyle: 'long', timeStyle: 'short' }).format(d);
    } catch (e1) {
      try {
        return d.toLocaleString(tag);
      } catch (e2) {
        return d.toLocaleString();
      }
    }
  }

  function hydratePxIllustDate(loc) {
    var el = document.getElementById('px-illust-datetime');
    if (!el) return;
    var iso = el.getAttribute('datetime');
    if (!iso) return;
    function apply(loc) {
      el.textContent = formatPxIllustDate(iso, loc);
      el.setAttribute('title', iso);
    }
    if (loc != null) {
      apply(loc);
      return;
    }
    if (window.__bridge && window.__bridge.getLocale) {
      window.__bridge.getLocale().then(apply).catch(function () {
        apply('en');
      });
    } else {
      apply((navigator.language || 'en').split('-')[0]);
    }
  }

  /** 作品说明里 Pixiv 返回的相对链接、jump.php 外链，统一归一化后交给全局 a 点击桥接 */
  function normalizePixivDescLinks(scope) {
    if (!scope) return;
    var anchors = scope.querySelectorAll('a[href]');
    for (var i = 0; i < anchors.length; i++) {
      var a = anchors[i];
      if (!a || a.classList.contains('px-open')) continue;
      var h = a.getAttribute('href');
      if (!h || h === '#') continue;
      var out = null;
      if (h.indexOf('jump.php') >= 0) {
        var qi = h.indexOf('?');
        var q = qi >= 0 ? h.slice(qi + 1) : '';
        try {
          out = decodeURIComponent(q);
        } catch (err) {
          out = null;
        }
        if (!out || !/^https?:\/\//i.test(out)) out = null;
      } else if (h.charAt(0) === '/') {
        out = 'https://www.pixiv.net' + h;
      } else if (/^https?:\/\//i.test(h)) {
        out = h;
      } else if (/^\/\//.test(h)) {
        out = 'https:' + h;
      }
      if (!out) continue;
      a.setAttribute('href', out);
    }
  }

  function updatePxTitle(body) {
    var title = body && (body.title || body.illustTitle) != null ? String(body.title || body.illustTitle) : '';
    var link = document.getElementById('px-title-link');
    var text = document.getElementById('px-title-text');
    if (link) {
      link.textContent = title;
      setPxHidden(link, !title);
      if (ILLUST_ID) link.setAttribute('data-url', 'https://www.pixiv.net/artworks/' + encodeURIComponent(ILLUST_ID));
    }
    if (text) {
      text.textContent = title;
      setPxHidden(text, !title);
    }
  }

  function updatePxAuthorFromIllust(body) {
    var bar = document.getElementById('px-author-bar');
    if (!bar) return;
    var aid = extractAuthorIdFromIllustBody(body);
    if (!aid) aid = String(PX_SEEDED_AUTHOR_ID || '');
    var uname = body && body.userName != null ? String(body.userName) : '';
    if (!aid && !uname) {
      setPxHidden(bar, true);
      return;
    }
    setPxHidden(bar, false);
    pxLastAuthorAjaxSuccessId = '';
    var link = document.getElementById('px-author-link');
    var nameEl = document.getElementById('px-author-name');
    var img = document.getElementById('px-author-avatar');
    var disp = uname || aid;
    if (nameEl) nameEl.textContent = disp;
    if (link && aid) link.setAttribute('data-url', 'https://www.pixiv.net/users/' + encodeURIComponent(aid));
    if (img) {
      img.src = PXIMG_PLACEHOLDER;
      img.removeAttribute('data-px-profile-src');
      img.alt = disp || '';
    }
  }

  function updatePxCaption(body, loc) {
    var wrap = document.getElementById('px-illust-desc-wrap');
    var inner = document.getElementById('px-illust-desc');
    if (!wrap || !inner) return;
    var html = body && (body.description || body.illustComment) != null ? String(body.description || body.illustComment) : '';
    inner.innerHTML = html;
    normalizePixivDescLinks(inner);
    setPxHidden(wrap, !html);
    if (html) initPxCaptionExpand(loc);
  }

  /** 展示：有 translation.en 用其文案；跳转仍用原始 tag（Pixiv 标签页 slug） */
  function pxTagSlugAndLabel(row) {
    var slug = row && row.tag != null ? String(row.tag) : '';
    if (!slug) return null;
    var tr = row.translation;
    var en = tr && tr.en != null ? String(tr.en).trim() : '';
    return { slug: slug, label: en || slug };
  }

  function updatePxTags(body) {
    var list = document.getElementById('px-illust-tags');
    if (!list) return;
    while (list.firstChild) list.removeChild(list.firstChild);
    var rows = body && body.tags && Array.isArray(body.tags.tags) ? body.tags.tags : [];
    for (var i = 0; i < rows.length; i++) {
      var pair = pxTagSlugAndLabel(rows[i]);
      if (!pair) continue;
      var li = document.createElement('li');
      li.style.margin = '0';
      var a = document.createElement('a');
      a.href = '#';
      a.className = 'px-open';
      a.setAttribute('data-url', 'https://www.pixiv.net/tags/' + encodeURIComponent(pair.slug) + '/artworks');
      a.style.cssText = 'font-size:0.78rem;color:' + pxCssVar('--anime-primary', '#6366f1') + ';';
      a.textContent = '#' + pair.label;
      li.appendChild(a);
      list.appendChild(li);
    }
    setPxHidden(list, list.children.length === 0);
  }

  function updatePxStatValue(id, value) {
    var el = document.getElementById(id);
    if (!el) return;
    setPxHidden(el, value == null || value === '');
    if (value == null || value === '') return;
    var spans = el.getElementsByTagName('span');
    if (spans && spans.length) spans[spans.length - 1].textContent = String(value);
  }

  function updatePxDate(body, loc) {
    var el = document.getElementById('px-illust-datetime');
    if (!el) return;
    var iso = body && (body.uploadDate != null || body.createDate != null) ? String(body.uploadDate != null ? body.uploadDate : body.createDate) : '';
    setPxHidden(el, !iso);
    if (!iso) {
      el.removeAttribute('datetime');
      el.textContent = '';
      return;
    }
    el.setAttribute('datetime', iso);
    hydratePxIllustDate(loc);
  }

  function applyLatestIllustBody(body, loc) {
    if (!body || typeof body !== 'object') return;
    updatePxTitle(body);
    updatePxAuthorFromIllust(body);
    updatePxCaption(body, loc);
    updatePxTags(body);
    updatePxStatValue('px-stat-bookmark', body.bookmarkCount);
    updatePxStatValue('px-stat-like', body.likeCount);
    updatePxStatValue('px-stat-view', body.viewCount);
    updatePxDate(body, loc);
    hydrateAuthorAjax(body, loc || 'en');
  }

  function refreshIllustPresentation(loc) {
    var appLoc = loc || 'en';
    if (!ILLUST_ID || !window.__bridge || !window.__bridge.fetch) {
      hydrateAuthorAjax(null, appLoc);
      return;
    }
    fetchIllustBody(pixivLang(appLoc)).then(function (json) {
      if (!json || json.error || !json.body) {
        hydrateAuthorAjax(null, appLoc);
        return;
      }
      applyLatestIllustBody(json.body, appLoc);
    }).catch(function () {
      hydrateAuthorAjax(null, appLoc);
    });
  }

  /** i.pximg.net/user-profile 需 Referer；iframe 无 Pixiv Referer，经 __bridge.fetch 拉取后转 blob */
  function hydratePxProfileImages(root) {
    if (!window.__bridge || !window.__bridge.fetch) return;
    var scope = root || document;
    var imgs = scope.querySelectorAll('img[data-px-profile-src]');
    for (var i = 0; i < imgs.length; i++) {
      (function (im) {
        var u = im.getAttribute('data-px-profile-src');
        if (!u) return;
        im.removeAttribute('data-px-profile-src');
        window.__bridge.fetch(u, { headers: PXIMG_PROXY_HEADERS }).then(function (res) {
          if (!res || !res.base64) return;
          var bin = atob(res.base64);
          var arr = new Uint8Array(bin.length);
          for (var j = 0; j < bin.length; j++) arr[j] = bin.charCodeAt(j);
          var blob = new Blob([arr], { type: res.contentType || 'image/jpeg' });
          im.src = URL.createObjectURL(blob);
        }).catch(function () {
          im.src = u;
        });
      })(imgs[i]);
    }
  }

  function onReady() {
    hydratePxIllustDate();

    function startCaptionExpand(l) {
      var loc = l || 'en';
      initPxCaptionExpand(loc);
      hydratePxIllustDate(loc);
      refreshIllustPresentation(loc);
    }
    if (document.getElementById('px-illust-desc-clip')) {
      if (window.__bridge && window.__bridge.getLocale) {
        window.__bridge.getLocale().then(startCaptionExpand).catch(function () {
          startCaptionExpand('en');
        });
      } else {
        startCaptionExpand((navigator.language || 'en').split('-')[0]);
      }
    }

  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', onReady);
  else onReady();
})();
</script>
