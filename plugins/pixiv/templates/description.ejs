<% const m = metadata || {}; %>
<% const b = (m.body != null && typeof m.body === 'object' && !Array.isArray(m.body)) ? m.body : null; %>
<% const illustId = b ? String(b.illustId || b.id || '') : (m.illustId != null ? String(m.illustId) : ''); %>
<% const artworkHref = illustId ? ('https://www.pixiv.net/artworks/' + encodeURIComponent(illustId)) : ''; %>
<% const pxTitle = b ? String(b.title || b.illustTitle || '') : ''; %>
<% const pxCaption = b ? String(b.description || b.illustComment || '') : ''; %>
<% const pxTags = (b && b.tags && Array.isArray(b.tags.tags)) ? b.tags.tags : []; %>
<% const pxUid = b && b.userId != null ? String(b.userId) : ''; %>
<% const pxUname = b && b.userName != null ? String(b.userName) : ''; %>
<% const pxAuthorId = (b && b.tags && b.tags.authorId != null) ? String(b.tags.authorId) : pxUid; %>
<% const pxUserHref = pxUid ? ('https://www.pixiv.net/users/' + encodeURIComponent(pxUid)) : ''; %>
<% const pxAuthorHref = pxAuthorId ? ('https://www.pixiv.net/users/' + encodeURIComponent(pxAuthorId)) : pxUserHref; %>
<% const pxDateIso = b && (b.uploadDate != null || b.createDate != null) ? String(b.uploadDate != null ? b.uploadDate : b.createDate) : ''; %>
<% const pxComments = Array.isArray(m.comments) ? m.comments : []; %>
<%
const PX_STAMP_NAME_TO_ID = {normal:101,surprise:102,serious:103,heaven:104,happy:105,excited:106,sing:107,cry:108,normal2:201,shame2:202,love2:203,interesting2:204,blush2:205,fire2:206,angry2:207,shine2:208,panic2:209,normal3:301,satisfaction3:302,surprise3:303,smile3:304,shock3:305,gaze3:306,wink3:307,happy3:308,excited3:309,love3:310,normal4:401,surprise4:402,serious4:403,love4:404,shine4:405,sweat4:406,shame4:407,sleep4:408,heart:501,teardrop:502,star:503};
const PXIMG_STATIC = 'https://s.pximg.net/common/images/';
function _pxEmojiImg(id, px) {
  return '<img src="' + PXIMG_STATIC + 'emoji/' + id + '.png" width="' + px + '" height="' + px + '" alt="" class="px-comment-emoji" referrerpolicy="no-referrer" style="width:' + px + 'px;height:' + px + 'px;vertical-align:middle;display:inline-block;object-fit:contain;">';
}
function _pxStampImg(id, px) {
  return '<img src="' + PXIMG_STATIC + 'stamp/generated-stamps/' + id + '_s.jpg?20180605" width="' + px + '" height="' + px + '" alt="" class="px-comment-emoji" referrerpolicy="no-referrer" style="width:' + px + 'px;height:' + px + 'px;vertical-align:middle;display:inline-block;object-fit:contain;">';
}
function pxCommentBodyHtml(comment, stampId) {
  const c = String(comment || '');
  const sid = (stampId != null && stampId !== '') ? String(stampId).trim() : '';
  if (sid && !c.trim()) {
    return '<div class="px-comment-body px-comment-body--solo">' + _pxStampImg(sid, 80) + '</div>';
  }
  const re = /\(([a-zA-Z0-9_]+)\)/g;
  const parts = []; let last = 0, mx; let known = 0;
  while ((mx = re.exec(c)) !== null) {
    if (mx.index > last) parts.push({ t: 'text', v: c.slice(last, mx.index) });
    const nid = PX_STAMP_NAME_TO_ID[mx[1]];
    if (nid != null) { parts.push({ t: 'emoji', id: String(nid) }); known++; }
    else parts.push({ t: 'text', v: mx[0] });
    last = mx.index + mx[0].length;
  }
  if (last < c.length) parts.push({ t: 'text', v: c.slice(last) });
  const solo = known === 1 && parts.length === 1 && parts[0].t === 'emoji';
  const epx = solo ? 80 : 24;
  let html = '<div class="px-comment-body' + (solo ? ' px-comment-body--solo' : '') + '">';
  for (const p of parts) {
    if (p.t === 'text') html += p.v.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    else html += _pxEmojiImg(p.id, epx);
  }
  return html + '</div>';
}
function pxFmtDate(s) {
  if (!s) return '';
  try { return String(s).replace('T', ' ').slice(0, 16); } catch(e) { return String(s); }
}
