{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.pixiv",
  "name": "number_range_provider",
  // 数值区间过滤：metadata 中 json_path 指向的数值落在闭区间 [min, max] 内。
  // 缺失或空串的图不命中任何区间。
  "properties": {
    "json_path": { "type": "string", "default": "$.body.likeCount", "optional": false },
    "min": { "type": "number", "default": -9007199254740991, "optional": true },
    "max": { "type": "number", "default": 9007199254740991, "optional": true }
  },
  "query": {
    "where": "COALESCE((CAST(REPLACE(NULLIF(TRIM(CAST(json_extract(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, ${properties.json_path}) AS TEXT)), ''), ',', '') AS INTEGER) BETWEEN ${properties.min} AND ${properties.max}), 0)"
  }
}
