{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.pixiv",
  "name": "tag_provider",
  "properties": {
    "tag_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(pixiv_tags) THEN pixiv_tags ELSE json('[]') END) AS tag WHERE NULLIF(TRIM(CAST(json_extract(tag.value, '$.tag') AS TEXT)), '') = ${properties.tag_name})"
  },
  "list": {
    "${out.name}": {
          "child_var": "out",
          "delegate": {
              "provider": "kabegame.paginate100_provider",
          },
          "provider": "${out.provider}",
          "meta": "${out.meta}"
      }
  },
  "resolve": {
    "desc|x[1-9][0-9]*x|[1-9][0-9]*": {
      "delegate": {
        "provider": "kabegame.gallery_desc_pagination_page_comb"
      },
      "child_var": "child",
      "provider": "${child.provider}",
      "meta": "${child.meta}"
    }
  }
}
