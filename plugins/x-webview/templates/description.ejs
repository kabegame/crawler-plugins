<%
  const m = metadata || {};
  const t = m.tweet || {};
  const a = m.author || {};
  const c = t.counts || {};
  const media = Array.isArray(m.media) ? m.media : [];
  const fmtNum = (n) => {
    if (n === null || n === undefined || n === "") return "";
    const v = Number(n);
    if (!Number.isFinite(v)) return "";
    if (v >= 1e8) return (v / 1e8).toFixed(1).replace(/\.0$/, "") + "亿";
    if (v >= 1e4) return (v / 1e4).toFixed(1).replace(/\.0$/, "") + "万";
    return String(v);
  };
  const pad = (n) => String(n).padStart(2, "0");
  let timeText = "";
  if (t.createdAt) {
    const d = new Date(t.createdAt);
    if (!isNaN(d)) timeText = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  }
  // 正文切成「普通文本 / #话题 / @提及 / 链接」片段，分别着色
  const splitText = (raw) => {
    const out = [];
    const text = String(raw || "");
    const re = /(https?:\/\/\S+|#[^\s#@!$%^&*()=+.,\/\\'"?<>~`、。，！？「」]+|@[A-Za-z0-9_]{1,15})/g;
    let last = 0, mm;
    while ((mm = re.exec(text))) {
      if (mm.index > last) out.push({ k: "text", v: text.slice(last, mm.index) });
      const v = mm[0];
      if (v[0] === "#") out.push({ k: "link", v, href: "https://x.com/hashtag/" + encodeURIComponent(v.slice(1)) });
      else if (v[0] === "@") out.push({ k: "link", v, href: "https://x.com/" + v.slice(1) });
      else out.push({ k: "link", v: v.replace(/^https?:\/\//, "").slice(0, 40) + (v.length > 48 ? "…" : ""), href: v });
      last = mm.index + v.length;
    }
    if (last < text.length) out.push({ k: "text", v: text.slice(last) });
    return out;
  };
  const parts = splitText(t.text);
  const fmtTime = (iso) => {
    const d = new Date(iso);
    return isNaN(d) ? "" : `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;
  };
  // 回复：按出现顺序排，回复其他回复的（楼中楼）缩进一级；pbs 缩略图取 small 档
  const comments = Array.isArray(m.comments) ? m.comments : [];
  const commentIds = new Set(comments.map((x) => x.id));
  const thumb = (x) => {
    const u = String(x.poster || x.url || "");
    const mt = u.match(/^(https:\/\/pbs\.twimg\.com\/[^?]+?)\.(\w+)$/);
    return mt ? `${mt[1]}?format=${mt[2]}&name=small` : u;
  };
  const photos = media.filter((x) => x.type === "photo").length;
  const videos = media.length - photos;
%>
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  :root {
    --text: #0f1419; --sub: #536471; --line: #eff3f4; --blue: #1d9bf0;
    --bg: #ffffff; --chip: #f7f9f9; --red: #f91880; --green: #00ba7c;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 12px; background: var(--bg); color: var(--text);
    font: 15px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Sans", "Noto Sans CJK JP", "PingFang SC", sans-serif;
  }
  a { color: var(--blue); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .card { border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; }
  .head { display: flex; gap: 10px; align-items: center; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; flex: none; background: var(--chip); }
  .who { min-width: 0; }
  .name { font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 4px; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .badge { width: 17px; height: 17px; fill: var(--blue); flex: none; }
  .handle { color: var(--sub); font-size: 14px; }
  .text { margin: 12px 0 0; white-space: pre-wrap; word-break: break-word; font-size: 16px; }
  .meta { color: var(--sub); font-size: 14px; margin-top: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
  .meta b { color: var(--text); }
  .stats { display: flex; flex-wrap: wrap; gap: 4px 18px; padding-top: 10px; color: var(--sub); font-size: 13px; }
  .stat { display: flex; align-items: center; gap: 5px; }
  .stat svg { width: 18px; height: 18px; fill: currentColor; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .tag { background: var(--chip); border-radius: 9999px; padding: 2px 10px; font-size: 13px; }
  .sens { display: inline-block; margin-left: 6px; padding: 0 6px; border-radius: 4px; font-size: 12px; color: var(--red); border: 1px solid var(--red); }
  .alt { margin-top: 10px; font-size: 13px; color: var(--sub); white-space: pre-wrap; }
  .alt b { color: var(--text); font-weight: 600; }
  .replies { margin-top: 14px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
  .replies-head { padding: 10px 16px; font-weight: 700; border-bottom: 1px solid var(--line); }
  .replies-head span { font-weight: 400; color: var(--sub); font-size: 13px; }
  .reply { display: flex; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
  .reply:last-child { border-bottom: none; }
  .reply.nested { padding-left: 50px; background: #fbfcfc; }
  .reply .avatar { width: 34px; height: 34px; }
  .reply-body { min-width: 0; flex: 1; }
  .reply-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 6px; font-size: 14px; }
  .reply-top .rn { font-weight: 700; color: var(--text); }
  .reply-top .rh, .reply-top .rt { color: var(--sub); }
  .op { font-size: 11px; color: var(--blue); border: 1px solid var(--blue); border-radius: 4px; padding: 0 4px; }
  .reply-to { font-size: 13px; color: var(--sub); }
  .reply-text { margin: 2px 0 0; white-space: pre-wrap; word-break: break-word; font-size: 15px; }
  .reply-media { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }
  .reply-media a { position: relative; display: block; }
  .reply-media img { width: 96px; height: 96px; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); display: block; }
  .reply-media .play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 22px; text-shadow: 0 0 6px rgba(0,0,0,.6); }
  .reply-stats { display: flex; gap: 16px; margin-top: 4px; color: var(--sub); font-size: 12px; }
  .bio { margin-top: 12px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 13px; color: var(--sub); white-space: pre-wrap; word-break: break-word; }
</style>
</head>
<body>
<div class="card">
  <div class="head">
    <% if (a.avatar) { %><a href="https://x.com/<%= a.screenName %>" target="_blank"><img class="avatar" src="<%= a.avatar %>" referrerpolicy="no-referrer" alt=""></a><% } %>
    <div class="who">
      <a class="name" href="https://x.com/<%= a.screenName %>" target="_blank"><%= a.name || a.screenName %>
        <% if (a.verified) { %><svg class="badge" viewBox="0 0 22 22"><path d="M20.4 11c0-1.3-.8-2.5-2-3 .3-1.3-.1-2.6-1-3.5-.9-.9-2.3-1.3-3.5-1-.6-1.2-1.7-2-3-2s-2.5.8-3 2c-1.3-.3-2.6.1-3.5 1-.9.9-1.3 2.3-1 3.5-1.2.5-2 1.7-2 3s.8 2.5 2 3c-.3 1.3.1 2.6 1 3.5.9.9 2.3 1.3 3.5 1 .5 1.2 1.7 2 3 2s2.5-.8 3-2c1.3.3 2.6-.1 3.5-1 .9-.9 1.3-2.3 1-3.5 1.2-.5 2-1.7 2-3zm-11.7 4.3-3.6-3.6 1.3-1.3 2.3 2.3 4.9-4.9 1.3 1.3-6.2 6.2z"/></svg><% } %>
      </a>
      <div class="handle">@<%= a.screenName %></div>
    </div>
  </div>

  <% if (parts.length) { %><p class="text"><% for (const p of parts) { %><% if (p.k === "link") { %><a href="<%= p.href %>" target="_blank"><%= p.v %></a><% } else { %><%= p.v %><% } %><% } %></p><% } %>

  <% for (const [i, x] of media.entries()) { if (x.alt) { %><div class="alt"><b>ALT <%= media.length > 1 ? i + 1 : "" %></b> <%= x.alt %></div><% } } %>

  <div class="meta">
    <% if (t.url) { %><a href="<%= t.url %>" target="_blank"><%= timeText || "原推文" %></a><% } else { %><%= timeText %><% } %>
    <% if (c.view !== null && c.view !== undefined) { %> · <b><%= fmtNum(c.view) %></b> 次浏览<% } %>
    · <%= photos ? photos + " 图" : "" %><%= photos && videos ? " + " : "" %><%= videos ? videos + " 视频" : "" %>
    <% if (t.possiblySensitive) { %><span class="sens">敏感内容</span><% } %>
  </div>

  <div class="stats">
    <span class="stat" title="回复"><svg viewBox="0 0 24 24"><path d="M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 7.501 3.58 7.501 8.13 0 2.74-1.34 5.24-3.48 6.79L9.86 22.5v-4.5h-.11c-4.42 0-8-3.58-8-8z"/></svg><%= fmtNum(c.reply) %></span>
    <span class="stat" title="转推" style="color:var(--green)"><svg viewBox="0 0 24 24"><path d="M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z"/></svg><%= fmtNum(c.retweet) %></span>
    <% if (c.quote) { %><span class="stat" title="引用">引用 <%= fmtNum(c.quote) %></span><% } %>
    <span class="stat" title="喜欢" style="color:var(--red)"><svg viewBox="0 0 24 24"><path d="M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91z"/></svg><%= fmtNum(c.like) %></span>
    <span class="stat" title="书签"><svg viewBox="0 0 24 24"><path d="M4 4.5C4 3.12 5.119 2 6.5 2h11C18.881 2 20 3.12 20 4.5v18.44l-8-5.71-8 5.71V4.5z"/></svg><%= fmtNum(c.bookmark) %></span>
  </div>

  <% if ((t.hashtags || []).length) { %>
  <div class="tags"><% for (const h of t.hashtags) { %><a class="tag" href="https://x.com/hashtag/<%= encodeURIComponent(h) %>" target="_blank">#<%= h %></a><% } %></div>
  <% } %>

  <% if (a.description) { %><div class="bio"><%= a.description %></div><% } %>
</div>

<% if (comments.length) { %>
<div class="replies">
  <div class="replies-head">回复 <span>已保存 <%= comments.length %><%= c.reply > comments.length ? ` / 共 ${fmtNum(c.reply)}` : "" %> 条</span></div>
  <% for (const r of comments) { const ra = r.author || {}; const nested = r.parentId && commentIds.has(r.parentId); const rc = r.counts || {}; %>
  <div class="reply<%= nested ? " nested" : "" %>">
    <% if (ra.avatar) { %><a href="https://x.com/<%= ra.screenName %>" target="_blank"><img class="avatar" src="<%= ra.avatar %>" referrerpolicy="no-referrer" alt=""></a><% } %>
    <div class="reply-body">
      <div class="reply-top">
        <a class="rn" href="https://x.com/<%= ra.screenName %>" target="_blank"><%= ra.name || ra.screenName %></a>
        <% if (r.isAuthor) { %><span class="op">作者</span><% } %>
        <span class="rh">@<%= ra.screenName %></span>
        <a class="rt" href="<%= r.url %>" target="_blank">· <%= fmtTime(r.createdAt) %></a>
      </div>
      <% if (r.replyTo && nested) { %><div class="reply-to">回复 <a href="https://x.com/<%= r.replyTo %>" target="_blank">@<%= r.replyTo %></a></div><% } %>
      <% const rp = splitText(r.text); if (rp.length) { %><p class="reply-text"><% for (const p of rp) { %><% if (p.k === "link") { %><a href="<%= p.href %>" target="_blank"><%= p.v %></a><% } else { %><%= p.v %><% } %><% } %></p><% } %>
      <% if ((r.media || []).length) { %>
      <div class="reply-media"><% for (const x of r.media) { %><a href="<%= x.url || x.poster %>" target="_blank"><img src="<%= thumb(x) %>" referrerpolicy="no-referrer" alt=""><% if (x.type !== "photo") { %><span class="play">▶</span><% } %></a><% } %></div>
      <% } %>
      <div class="reply-stats">
        <% if (rc.reply) { %><span>回复 <%= fmtNum(rc.reply) %></span><% } %>
        <% if (rc.retweet) { %><span style="color:var(--green)">转推 <%= fmtNum(rc.retweet) %></span><% } %>
        <% if (rc.like) { %><span style="color:var(--red)">♥ <%= fmtNum(rc.like) %></span><% } %>
      </div>
    </div>
  </div>
  <% } %>
</div>
<% } %>
</body>
</html>
