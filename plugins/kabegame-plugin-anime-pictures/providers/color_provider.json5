{
  "$schema": "../../../../src-tauri/kabegame-core/src/providers/dsl/schema.json5",
  "namespace": "plugins.anime-pictures",
  "name": "color_provider",
  "properties": {
    "color_name": { "type": "string", "default": "", "optional": false }
  },
  "query": {
    "where": "COALESCE((EXISTS (SELECT 1 FROM json_each(CASE WHEN json_valid(plugin_im.data) THEN plugin_im.data ELSE '{}' END, '$.details') AS detail WHERE json_extract(detail.value, '$.color') IS NOT NULL AND NULLIF(TRIM(CAST(json_extract(detail.value, '$.links[0].text') AS TEXT)), '') = ${properties.color_name})), 0)"
  }
}
