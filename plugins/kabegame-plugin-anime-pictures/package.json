{
  "name": "kabegame-plugin-anime-pictures",
  "version": "0.7.0",
  "private": true,
  "name.zh": "anime-pictures动漫图库",
  "name.en": "anime-pictures anime gallery",
  "name.ja": "anime-picturesアニメ図庫",
  "name.ko": "anime-pictures 애니메이션 갤러리",
  "description": "anime-pictures动漫图库收集源插件（可按标签检索）",
  "description.zh": "anime-pictures动漫图库收集源插件（可按标签检索）",
  "description.en": "anime-pictures anime gallery crawler (tag search)",
  "description.ja": "anime-picturesアニメ図庫収集プラグイン（タグ検索可）",
  "description.ko": "anime-pictures 애니메이션 갤러리 수집 플러그인(태그 검색 가능)",
  "author": "Kabegame",
  "kbPackageVersion": 3,
  "engines": {
    "kabegame": ">=4.5.2"
  },
  "main": "dist/main.js",
  "kbBackend": "v8",
  "scripts": {
    "build": "rspack build"
  },
  "kbBaseUrl": "https://anime-pictures.net",
  "kbLabels": [
    {
      "id": "auth.needProxy"
    }
  ],
  "kbConfig": [
    {
      "key": "tag",
      "type": "string",
      "name": "标签",
      "name.en": "Tag",
      "name.ja": "タグ",
      "name.ko": "태그",
      "name.zhtw": "標籤",
      "descripts": "要拉取的标签（默认无标签爬全站）",
      "descripts.en": "Tag to filter (empty = all)",
      "descripts.ja": "フィルター用タグ（空欄で全件）",
      "descripts.ko": "필터 태그 (비우면 전체)",
      "descripts.zhtw": "要拉取的標籤（預設無標籤爬全站）"
    },
    {
      "key": "postsPerPage",
      "type": "int",
      "name": "每页大小",
      "name.en": "Posts per page",
      "name.ja": "1ページの件数",
      "name.ko": "페이지당 항목 수",
      "name.zhtw": "每頁大小",
      "descripts": "每页拉取的图片数（1～100）",
      "descripts.en": "Number of images fetched per page (1–100)",
      "descripts.ja": "1ページあたりに取得する画像数（1～100）",
      "descripts.ko": "페이지당 가져올 이미지 수 (1~100)",
      "descripts.zhtw": "每頁拉取的圖片數（1～100）",
      "default": 80,
      "min": 1,
      "max": 100,
      "width": 2
    },
    {
      "key": "orderBy",
      "type": "options",
      "name": "排序方法",
      "name.en": "Sort order",
      "name.ja": "並び順",
      "name.ko": "정렬 방식",
      "name.zhtw": "排序方法",
      "default": "date",
      "width": 2,
      "options": [
        {
          "name": "日期（新到旧）",
          "name.en": "Date (newest first)",
          "name.ja": "日付（新しい順）",
          "name.ko": "날짜 (최신순)",
          "name.zhtw": "日期（新到舊）",
          "variable": "date"
        },
        {
          "name": "日期（旧到新）",
          "name.en": "Date (oldest first)",
          "name.ja": "日付（古い順）",
          "name.ko": "날짜 (오래된순)",
          "name.zhtw": "日期（舊到新）",
          "variable": "date_r"
        },
        {
          "name": "评分",
          "name.en": "Rating",
          "name.ja": "評価",
          "name.ko": "평점",
          "name.zhtw": "評分",
          "variable": "rating"
        },
        {
          "name": "浏览数",
          "name.en": "Views",
          "name.ja": "閲覧数",
          "name.ko": "조회수",
          "name.zhtw": "瀏覽數",
          "variable": "views"
        },
        {
          "name": "文件大小",
          "name.en": "File size",
          "name.ja": "ファイルサイズ",
          "name.ko": "파일 크기",
          "name.zhtw": "檔案大小",
          "variable": "size"
        },
        {
          "name": "标签数",
          "name.en": "Tag count",
          "name.ja": "タグ数",
          "name.ko": "태그 수",
          "name.zhtw": "標籤數",
          "variable": "tag_num"
        },
        {
          "name": "收藏日期",
          "name.en": "Favorite date",
          "name.ja": "お気に入り登録日",
          "name.ko": "즐겨찾기 날짜",
          "name.zhtw": "收藏日期",
          "variable": "stars_date"
        }
      ]
    },
    {
      "key": "startPage",
      "type": "int",
      "name": "起始页面",
      "name.en": "Start page",
      "name.ja": "開始ページ",
      "name.ko": "시작 페이지",
      "name.zhtw": "起始頁面",
      "descripts": "要拉取的起始页面",
      "descripts.en": "Start page to crawl from",
      "descripts.ja": "取得開始ページ",
      "descripts.ko": "가져올 시작 페이지",
      "descripts.zhtw": "要拉取的起始頁面",
      "default": 0,
      "min": 0,
      "width": 2
    },
    {
      "key": "endPage",
      "type": "int",
      "name": "结束页数",
      "name.en": "End page",
      "name.ja": "終了ページ",
      "name.ko": "끝 페이지",
      "name.zhtw": "結束頁數",
      "descripts": "要拉取的结束页面",
      "descripts.en": "End page to crawl to",
      "descripts.ja": "取得終了ページ",
      "descripts.ko": "가져올 끝 페이지",
      "descripts.zhtw": "要拉取的結束頁面",
      "default": 5,
      "min": 0,
      "width": 2
    }
  ],
  "kbIcon": "icon.png",
  "kbDoc": {
    "en": "README.en.md",
    "ja": "README.ja.md",
    "ko": "README.ko.md",
    "default": "README.md",
    "zhtw": "README.zhtw.md"
  },
  "kbChangelog": {
    "default": "CHANGELOG.md"
  },
  "kbAssets": [
    "doc-icon.png",
    "banners/hutao.png",
    "banners/scsho.png",
    "banners/images.jpg"
  ],
  "kbRecommendedConfigs": [
    "configs/blue-archive.json",
    "configs/every-day-pictures.json",
    "configs/girls.json",
    "configs/oli+o+o.json",
    "configs/pink-eye.json"
  ],
  "kbPathQLProviders": [
    "providers/color_provider.json5",
    "providers/color_router.json5",
    "providers/entry_provider.json5",
    "providers/number_range_provider.json5",
    "providers/number_range_router.json5"
  ],
  "kbMetadataMigration": "metadata_migrations/migrate.js",
  "kbDescriptionTemplate": "templates/description.ejs",
  "devDependencies": {
    "@kabegame/plugin-sdk": "file:../../../packages/kabegame-plugin-sdk",
    "@kabegame/types": "file:../../../packages/kabegame-types",
    "@rspack/cli": "^1",
    "@rspack/core": "^1",
    "typescript": "^5.5.0"
  }
}
